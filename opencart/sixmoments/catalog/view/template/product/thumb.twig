<article class="moment-card product-card">
  <a href="{{ href }}"><div class="moment-art"><img class="product-photo" src="{{ thumb }}" alt="{{ name }}" loading="lazy"><span class="moment-number">{{ six_moment }}</span><span class="card-arrow">↗</span></div><p class="product-kicker">{{ six_moment }}</p><div class="product-line"><h3>{{ name }}</h3><span class="card-price">{% if special %}<del>{{ price }}</del>{{ special }}{% else %}{{ price }}{% endif %}</span></div><p>{{ description }}</p><dl class="card-specs"><div><dt>{{ six_product_code }}</dt><dd>{{ six_sku }}</dd></div><div><dt>{{ six_weight }}</dt><dd>{{ six_product_weight }}</dd></div></dl></a>
  <form class="card-footer" method="post" data-oc-toggle="ajax" data-oc-load="{{ cart }}" data-oc-target="#cart"><span class="stock-status{% if six_stocked %} is-stocked{% endif %}">{% if six_stocked %}{{ six_in_stock }}{% else %}{{ six_preorder }}{% endif %}</span><button type="submit" formaction="{{ cart_add }}">{{ six_add_to_bag }}</button><input type="hidden" name="product_id" value="{{ product_id }}"><input type="hidden" name="quantity" value="{{ minimum }}"></form>
</article>
