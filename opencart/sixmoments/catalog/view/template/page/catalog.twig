{{ header }}
<section class="interior-hero catalog-hero"><div><p class="eyebrow">{{ six_collections }}</p><h1>{{ six_catalog_title }}</h1><p>{{ six_catalog_intro }}</p></div></section>
<main class="six-catalog-page">
  <nav class="catalog-dual-nav" aria-label="{{ six_shop_by_type }}">
    <div><strong>{{ six_shop_by_type }}</strong><a href="{{ clear_url }}"{% if not filters.type and not filters.category_id %} class="is-active"{% endif %}>{{ six_all }}</a>{% for type in types %}<a href="{{ type.href }}"{% if filters.type == type.value %} class="is-active"{% endif %}>{{ type.name }}</a>{% endfor %}</div>
    <div><strong>{{ six_shop_by_moment }}</strong><a href="{{ clear_url }}"{% if not filters.moment %} class="is-active"{% endif %}>{{ six_all }}</a>{% for moment in moments %}<a href="{{ moment.href }}"{% if filters.moment == moment.value %} class="is-active"{% endif %}>{{ moment.name }}</a>{% endfor %}</div>
  </nav>
  <div class="catalog-shell">
    <aside class="catalog-filters" data-six-filters>
      <div class="filter-heading"><h2>{{ six_filters }}</h2><a href="{{ clear_url }}">{{ six_clear }}</a></div>
      <form action="{{ catalog_action }}" method="get"{% if ajax_filter_status %} data-six-ajax-filter{% endif %}>
        <input type="hidden" name="route" value="extension/sixmoments/page/catalog"><input type="hidden" name="language" value="{{ language }}">
        <label class="filter-search">{{ six_search }}<input type="search" name="q" value="{{ filters.q }}"></label>
        <details open><summary>{{ six_metal }}</summary><label><input type="radio" name="metal" value=""{% if not filters.metal %} checked{% endif %}> {{ six_all }}</label><label><input type="radio" name="metal" value="white-gold"{% if filters.metal == 'white-gold' %} checked{% endif %}> {{ six_white_gold }}</label><label><input type="radio" name="metal" value="yellow-gold"{% if filters.metal == 'yellow-gold' %} checked{% endif %}> {{ six_yellow_gold }}</label><label><input type="radio" name="metal" value="rose-gold"{% if filters.metal == 'rose-gold' %} checked{% endif %}> {{ six_rose_gold }}</label><label><input type="radio" name="metal" value="platinum"{% if filters.metal == 'platinum' %} checked{% endif %}> {{ six_platinum }}</label></details>
        <details><summary>{{ six_fineness }}</summary><label><input type="radio" name="fineness" value=""{% if not filters.fineness %} checked{% endif %}> {{ six_all }}</label><label><input type="radio" name="fineness" value="585"{% if filters.fineness == '585' %} checked{% endif %}> 585 / 14K</label><label><input type="radio" name="fineness" value="750"{% if filters.fineness == '750' %} checked{% endif %}> 750 / 18K</label><label><input type="radio" name="fineness" value="950"{% if filters.fineness == '950' %} checked{% endif %}> 950</label></details>
        {% if gemstones %}<details><summary>{{ six_gemstone }}</summary><label><input type="radio" name="gemstone" value=""{% if not filters.gemstone %} checked{% endif %}> {{ six_all }}</label>{% for item in gemstones %}<label><input type="radio" name="gemstone" value="{{ item.value }}"{% if filters.gemstone == item.value %} checked{% endif %}> {{ item.value }} <small>({{ item.total }})</small></label>{% endfor %}</details>{% endif %}
        <details><summary>{{ six_stone }}</summary><label><input type="radio" name="stone" value=""{% if not filters.stone %} checked{% endif %}> {{ six_all }}</label><label><input type="radio" name="stone" value="natural"{% if filters.stone == 'natural' %} checked{% endif %}> {{ six_natural }}</label><label><input type="radio" name="stone" value="lab-grown"{% if filters.stone == 'lab-grown' %} checked{% endif %}> {{ six_lab_grown }}</label><label><input type="radio" name="stone" value="no-stones"{% if filters.stone == 'no-stones' %} checked{% endif %}> {{ six_no_stones }}</label></details>
        <details{% if carat_min != '' or carat_max != '' %} open{% endif %}><summary>{{ six_carat }}</summary><div class="price-range attribute-range"><input type="number" name="carat_min" min="0" max="20" step="0.01" inputmode="decimal" value="{{ carat_min }}" placeholder="{{ six_from }}"><span>—</span><input type="number" name="carat_max" min="0" max="20" step="0.01" inputmode="decimal" value="{{ carat_max }}" placeholder="{{ six_to }}"></div></details>
        {% if stone_shapes %}<details><summary>{{ six_stone_shape }}</summary><label><input type="radio" name="stone_shape" value=""{% if not filters.stone_shape %} checked{% endif %}> {{ six_all }}</label>{% for item in stone_shapes %}<label><input type="radio" name="stone_shape" value="{{ item.value }}"{% if filters.stone_shape == item.value %} checked{% endif %}> {{ item.value }} <small>({{ item.total }})</small></label>{% endfor %}</details>{% endif %}
        {% if ring_sizes %}<details{% if filters.ring_size %} open{% endif %}><summary>{{ six_ring_size }}</summary><label><input type="radio" name="ring_size" value=""{% if not filters.ring_size %} checked{% endif %}> {{ six_all }}</label><div class="filter-size-grid">{% for item in ring_sizes %}<label><input type="radio" name="ring_size" value="{{ item.value }}"{% if filters.ring_size == item.value %} checked{% endif %}> <span>{{ item.value }}</span></label>{% endfor %}</div></details>{% endif %}
        {% if styles %}<details><summary>{{ six_jewelry_style }}</summary><label><input type="radio" name="style" value=""{% if not filters.style %} checked{% endif %}> {{ six_all }}</label>{% for item in styles %}<label><input type="radio" name="style" value="{{ item.value }}"{% if filters.style == item.value %} checked{% endif %}> {{ item.value }} <small>({{ item.total }})</small></label>{% endfor %}</details>{% endif %}
        <details><summary>{{ six_price }} · {{ currency_code }}</summary><div class="price-range"><input type="number" name="price_min" min="0" value="{{ price_min }}" placeholder="{{ six_from }}"><span>—</span><input type="number" name="price_max" min="0" value="{{ price_max }}" placeholder="{{ six_to }}"></div></details>
        <details><summary>{{ six_availability }}</summary><label><input type="radio" name="availability" value=""{% if not filters.availability %} checked{% endif %}> {{ six_all }}</label><label><input type="radio" name="availability" value="ready"{% if filters.availability == 'ready' %} checked{% endif %}> {{ six_ready }}</label><label><input type="radio" name="availability" value="preorder"{% if filters.availability == 'preorder' %} checked{% endif %}> {{ six_preorder }}</label></details>
        <details><summary>{{ six_delivery }}</summary><label><input type="radio" name="delivery" value=""{% if not filters.delivery %} checked{% endif %}> {{ six_all }}</label><label><input type="radio" name="delivery" value="delivery-3"{% if filters.delivery == 'delivery-3' %} checked{% endif %}> {{ six_delivery_3 }}</label><label><input type="radio" name="delivery" value="delivery-10"{% if filters.delivery == 'delivery-10' %} checked{% endif %}> {{ six_delivery_10 }}</label></details>
        {% if filters.type %}<input type="hidden" name="type" value="{{ filters.type }}">{% endif %}{% if filters.moment %}<input type="hidden" name="moment" value="{{ filters.moment }}">{% endif %}{% if filters.category_id %}<input type="hidden" name="category_id" value="{{ filters.category_id }}">{% endif %}{% if filters.sale %}<input type="hidden" name="sale" value="1">{% endif %}{% if filters.sort and filters.sort != 'popular' %}<input type="hidden" name="sort" value="{{ filters.sort }}">{% endif %}
        <button class="button button--dark" type="submit">{{ six_apply }}</button>
      </form>
    </aside>
    <section class="catalog-results" id="six-catalog-results" aria-live="polite">
      <div class="catalog-toolbar"><button class="filter-toggle" type="button" data-six-filter-toggle>{{ six_filters }}</button><strong>{{ total }} {{ six_pieces }}</strong><label>{{ six_sort }} <select data-six-catalog-sort>{% for sort in sorts %}<option value="{{ sort.href }}"{% if filters.sort == sort.value %} selected{% endif %}>{{ sort.name }}</option>{% endfor %}</select></label></div>
      {% if products %}<div class="collection-grid product-grid">{% for product in products %}{{ product }}{% endfor %}</div><div class="pagination-shell">{{ pagination }}<p>{{ result_text }}</p></div>{% else %}<div class="empty-state"><p>{{ six_no_products }}</p><a class="button button--dark" href="{{ clear_url }}">{{ six_clear }}</a></div>{% endif %}
    </section>
  </div>
</main>
{{ footer }}
