{{ header }}
<section class="hero" aria-label="6MOMENTS">
  <div class="hero-backgrounds"><div class="hero-background is-active" style="--hero-image:url('image/catalog/sixmoments/hero-6moments-v2.png');--hero-mobile-image:url('image/catalog/sixmoments/hero-6moments-mobile.png');background-position:58% 48%"></div></div>
  <div class="hero-copy"><p class="hero-kicker">{{ six_hero_kicker }}</p><h1>{{ six_hero_title }}</h1><div class="hero-actions"><a class="button button--dark" href="{{ six_catalog }}">{{ six_hero_primary }}</a><a class="hero-learn" href="{{ six_quiz }}">{{ six_hero_secondary }} <span>→</span></a></div></div>
</section>
<section class="moments-section editorial-products signature-section"><div class="editorial-heading"><p class="editorial-script">{{ six_signature }}</p><h2>{{ six_desired }}</h2><p>{{ six_desired_copy }}</p><a class="sale-link" href="{{ six_catalog }}">{{ six_view_all }} →</a></div><div class="collection-grid product-grid">{% for product in six_products|slice(0,3) %}{{ product }}{% endfor %}</div></section>
<section class="collections-intro"><div><p class="eyebrow">{{ six_collections }}</p><h2>{{ six_collections_title }}</h2><p>{{ six_collections_copy }}</p></div></section>
<section class="moment-tiles">{% for moment in six_moments %}<a class="moment-tile" href="{{ moment.href }}"><img src="{{ moment.image }}" alt=""><span class="moment-number">{{ moment.code }}</span><h3>{{ moment.title }}</h3></a>{% endfor %}</section>
{% if six_specials %}<section class="moments-section editorial-products sale-section"><div class="editorial-heading"><p class="editorial-script">{{ six_specials }}</p><h2>{{ six_specials_title }}</h2><a class="sale-link" href="{{ six_special }}">{{ six_view_all }} →</a></div><div class="sale-rail" data-six-rail>{% for product in six_specials %}{{ product }}{% endfor %}</div></section>{% endif %}
<section class="lab-diamond-banner"><div class="lab-diamond-media"><img src="{{ six_asset }}editorial/lab-grown-diamond.png" alt=""></div><div class="lab-diamond-copy"><p class="eyebrow">{{ six_lab_kicker }}</p><h2>{{ six_lab_title }}</h2><p>{{ six_lab_copy }}</p><div><a class="button button--light" href="{{ six_catalog }}&tag=lab-grown">{{ six_shop_lab }}</a><a class="text-link" href="{{ six_diamonds }}">{{ six_discover_more }} →</a></div></div></section>
<section class="brand-story"><div class="brand-story-visual"><img src="{{ six_asset }}about-quote-jewelry.webp" alt=""></div><div class="brand-story-copy"><p class="eyebrow">{{ six_story_kicker }}</p><h2>{{ six_story_title }}</h2><p class="brand-story-lead">{{ six_story_copy }}</p><a class="button story-button" href="{{ six_about }}">{{ six_read_story }} →</a></div></section>
<section class="instagram-callout"><div><p class="eyebrow">Instagram</p><h3>{{ six_follow }}</h3><p>{{ six_follow_copy }}</p></div><a class="button button--dark" href="{{ six_instagram }}" target="_blank" rel="noopener">@6moments_jewelry ↗</a></section>
{{ content_top }}{{ content_bottom }}
{{ footer }}
