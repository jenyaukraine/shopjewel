<!DOCTYPE html>
<html dir="{{ direction }}" lang="{{ lang }}" data-theme="{{ six_color_mode }}" data-theme-preference="{{ six_color_mode }}">
<head>
  <meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="color-scheme" content="light dark"><meta name="theme-color" content="#f8f5ef" data-six-theme-color>
  <script>try{const r=document.documentElement,c='{{ six_color_mode|escape('js') }}',s=localStorage.getItem('sixmoments-theme'),p=s||c,m=p==='auto'?(matchMedia('(prefers-color-scheme:dark)').matches?'dark':'light'):p;r.dataset.theme=m;r.dataset.themePreference=p}catch(e){document.documentElement.dataset.theme='light'}</script>
  <title>{{ title }}</title><base href="{{ base }}">
  {% if description %}<meta name="description" content="{{ description }}">{% endif %}
  {% if keywords %}<meta name="keywords" content="{{ keywords }}">{% endif %}
  <meta property="og:site_name" content="{{ six_brand_name }}"><meta property="og:title" content="{{ title }}"><meta property="og:type" content="website"><meta property="og:image" content="{{ six_og_image }}">{% if six_canonical %}<meta property="og:url" content="{{ six_canonical }}">{% endif %}
  <link rel="preload" as="image" href="/image/catalog/sixmoments/hero-6moments-v2.png" media="(min-width: 681px)" fetchpriority="high"><link rel="preload" as="image" href="/image/catalog/sixmoments/hero-6moments-mobile.png" media="(max-width: 680px)" fetchpriority="high">
  <script src="{{ jquery }}"></script>
  <link href="{{ bootstrap }}" rel="stylesheet"><link href="{{ icons }}" rel="stylesheet"><link href="{{ six_stylesheet }}" rel="stylesheet">
  <script src="catalog/view/javascript/common.js"></script>
  <link rel="icon" href="{{ six_favicon }}" type="image/svg+xml">
  {% for style in styles %}<link href="{{ style.href }}" rel="{{ style.rel }}" media="{{ style.media }}">{% endfor %}
  {% for script in scripts %}<script src="{{ script.href }}"></script>{% endfor %}
  {% for link in links %}<link href="{{ link.href }}" rel="{{ link.rel }}">{% endfor %}
  {% for analytic in analytics %}{{ analytic }}{% endfor %}
</head>
<body class="sixmoments-store" data-language="{{ six_language_code }}">
<div id="container" class="site-shell">
  <div id="alert"></div>
  <div class="announcement">{{ six_announcement }}</div>
  <header class="site-header">
    <a class="wordmark" href="{{ six_home }}" aria-label="{{ six_brand_name }}">{{ six_brand_name }}</a>
    <nav class="desktop-nav" aria-label="Primary">
      <span class="mega-menu-shell{% if six_mega_menu_status %} is-enabled{% endif %}"><a href="{{ six_catalog_url }}"{% if six_mega_menu_status %} aria-haspopup="true"{% endif %}>{{ six_catalog }}</a>{% if six_mega_menu_status %}<span class="mega-menu" role="group" aria-label="{{ six_mega_menu_title }}"><span class="mega-menu-heading"><small>{{ six_mega_menu_title }}</small><a href="{{ six_catalog_url }}">{{ six_view_all }} ↗</a></span><span class="mega-menu-grid">{% for category in six_categories %}<a href="{{ category.href }}"><strong>{{ category.name }}</strong><small>{{ category.total|default(0) }} {{ six_pieces }}</small></a>{% endfor %}</span><a class="mega-menu-promo" href="{{ six_mega_menu_promo_url }}"><span>{{ six_mega_menu_promo_text }}</span><b>↗</b></a></span>{% endif %}</span><a href="{{ six_about_url }}">{{ six_about }}</a><a href="{{ six_quiz_url }}">{{ six_quiz }}</a><a href="{{ six_journal_url }}">{{ six_journal }}</a>
    </nav>
    <div class="header-actions">
      <button class="header-search-trigger" type="button" data-six-search-open aria-label="{{ six_search }}">⌕</button>
      <button class="theme-toggle" type="button" data-six-theme-toggle aria-label="{{ six_theme_toggle }}" title="{{ six_theme_toggle }}"><span aria-hidden="true" data-six-theme-icon>◐</span></button>
      <span class="six-switcher" data-switcher="currency" data-current="{{ six_currency_code }}">{{ currency }}</span><span class="six-switcher" data-switcher="language" data-current="{{ six_language_code }}">{{ language }}</span>
      <a href="{{ contact }}">{{ six_contact }}</a>
      <a href="{{ shopping_cart }}" class="bag">{{ six_bag }} <span>{{ six_cart_count }}</span></a>
    </div>
    <button class="mobile-menu-trigger" type="button" data-six-menu-open aria-controls="six-mobile-menu" aria-expanded="false"><span>☰</span> {{ six_menu }}</button>
  </header>
  <div class="search-overlay" data-six-search aria-hidden="true">
    <button class="search-backdrop" type="button" data-six-search-close aria-label="Close"></button>
    <div class="search-panel"><button class="search-close" type="button" data-six-search-close>×</button><p class="eyebrow">{{ six_brand_name }}</p><form action="{{ six_search_action }}" method="get" data-six-search-form data-suggest-url="{{ six_search_suggest }}"><input type="hidden" name="route" value="extension/sixmoments/page/catalog"><input type="hidden" name="language" value="{{ six_language_code }}"><label for="six-site-search">{{ six_search }}</label><div><input id="six-site-search" type="search" name="q" autocomplete="off" placeholder="{{ six_search_placeholder }}"><button type="submit">→</button></div><div class="search-suggestions" data-six-suggestions></div></form></div>
  </div>
  <aside class="mobile-drawer-shell" id="six-mobile-menu" aria-hidden="true">
    <button class="mobile-drawer-backdrop" type="button" data-six-menu-close aria-label="Close"></button>
    <div class="mobile-drawer">
      <div class="mobile-drawer-header"><strong>{{ six_menu }}</strong><button type="button" data-six-menu-close>×</button></div>
      <nav class="mobile-category-nav">{% for category in six_categories %}<a href="{{ category.href }}"><span>◇</span>{{ category.name }}</a>{% endfor %}</nav>
      <nav class="mobile-main-nav">
        <a href="{{ six_home }}">⌂ {{ text_home }}</a><a href="{{ six_catalog_url }}">◇ {{ six_catalog }}</a><button type="button" data-six-search-open>⌕ {{ six_search }}</button><a href="{{ six_quiz_url }}">◎ {{ six_quiz }}</a><a href="{{ six_about_url }}">○ {{ six_about }}</a><a href="{{ six_diamonds_url }}">◇ {{ six_diamonds }}</a><a href="{{ six_journal_url }}">□ {{ six_journal }}</a>
      </nav>
      <div class="mobile-drawer-controls"><span data-switcher="currency" data-current="{{ six_currency_code }}">{{ currency|replace({'form-currency':'form-currency-mobile'}) }}</span><span data-switcher="language" data-current="{{ six_language_code }}">{{ language|replace({'form-language':'form-language-mobile'}) }}</span><button class="mobile-theme-toggle" type="button" data-six-theme-toggle><span>{{ six_theme_toggle }}</span><b aria-hidden="true" data-six-theme-icon>◐</b></button></div>
      <div class="mobile-drawer-contact"><a href="{{ shopping_cart }}">{{ six_bag }} · {{ six_cart_count }}</a><a href="{{ account|default(login) }}">{{ six_account }}</a></div>
    </div>
  </aside>
  {% if six_native_menu_status and menu %}<div class="six-extension-menu" data-six-extension-menu>{{ menu }}</div>{% endif %}
  <div class="six-search-bar">{{ search }}</div>
  <main id="main-content">
