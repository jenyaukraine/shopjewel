{{ header }}{{ column_left }}
<div id="content">
  <div class="page-header"><div class="container-fluid">
    <div class="float-end"><button type="submit" form="form-sixmoments" data-bs-toggle="tooltip" title="{{ button_save }}" class="btn btn-primary"><i class="fa-solid fa-save"></i></button><a href="{{ back }}" data-bs-toggle="tooltip" title="{{ button_back }}" class="btn btn-light"><i class="fa-solid fa-reply"></i></a></div>
    <h1>{{ heading_title }}</h1><ol class="breadcrumb">{% for breadcrumb in breadcrumbs %}<li class="breadcrumb-item"><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>{% endfor %}</ol>
  </div></div>
  <div class="container-fluid">
    <div class="alert alert-info"><i class="fa-solid fa-circle-info"></i> {{ text_installed }}</div>
    <div class="card border-success mb-3">
      <div class="card-header"><i class="fa-solid fa-circle-check text-success"></i> {{ text_readiness_title }}</div>
      <div class="card-body"><p class="text-muted">{{ text_readiness_help }}</p><div class="row g-2">
        <div class="col-md-6 col-xl-4"><div class="border rounded p-3 h-100"><span class="badge bg-success">✓ {{ text_ready_active }}</span><strong class="d-block mt-2">{{ text_ready_opencart }}</strong><small>OpenCart {{ opencart_version }}</small></div></div>
        <div class="col-md-6 col-xl-4"><div class="border rounded p-3 h-100"><span class="badge bg-success">✓ {{ text_ready_active }}</span><strong class="d-block mt-2">{{ text_ready_theme }}</strong><small>Auto · Light · Dark</small></div></div>
        <div class="col-md-6 col-xl-4"><div class="border rounded p-3 h-100"><span class="badge bg-success">✓ {{ text_ready_active }}</span><strong class="d-block mt-2">{{ text_ready_responsive }}</strong><small>360 px → desktop</small></div></div>
        <div class="col-md-6 col-xl-4"><div class="border rounded p-3 h-100"><span class="badge bg-success">✓ {{ text_ready_active }}</span><strong class="d-block mt-2">{{ text_ready_performance }}</strong><small>LCP priority · lazy images · stable ratios</small></div></div>
        <div class="col-md-6 col-xl-4"><div class="border rounded p-3 h-100"><span class="badge bg-success">✓ {{ text_ready_active }}</span><strong class="d-block mt-2">{{ text_ready_compatibility }}</strong><small>Core-safe event integration</small></div></div>
        <div class="col-md-6 col-xl-4"><div class="border rounded p-3 h-100"><span class="badge bg-success">✓ {{ text_ready_active }}</span><strong class="d-block mt-2">{{ text_ready_updates }}</strong><small>v{{ sixmoments_version }} · <a href="{{ update_feed }}" target="_blank" rel="noopener">JSON feed</a></small></div></div>
      </div></div>
    </div>
    <form id="form-sixmoments" action="{{ save }}" method="post" data-oc-toggle="ajax">
      <div class="card">
        <div class="card-header d-flex align-items-center justify-content-between"><span><i class="fa-solid fa-gem"></i> {{ text_edit }}</span><span class="badge bg-dark">v{{ sixmoments_version }}</span></div>
        <div class="card-body">
          <ul class="nav nav-tabs" role="tablist">
            <li class="nav-item"><button class="nav-link active" data-bs-toggle="tab" data-bs-target="#tab-general" type="button">{{ text_general }}</button></li>
            <li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#tab-builder" type="button">{{ text_page_builder }}</button></li>
            <li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#tab-navigation" type="button">{{ text_navigation }}</button></li>
            <li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#tab-ai" type="button">{{ text_ai_studio }}</button></li>
            <li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#tab-commerce" type="button">{{ text_commerce }}</button></li>
            <li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#tab-legal" type="button">{{ text_legal_details }}</button></li>
          </ul>
          <div class="tab-content pt-4">
            <section class="tab-pane fade show active" id="tab-general">
              <div class="row mb-3"><label class="col-sm-3 col-form-label">{{ entry_status }}</label><div class="col-sm-9"><div class="form-check form-switch form-switch-lg"><input type="hidden" name="module_sixmoments_status" value="0"><input class="form-check-input" type="checkbox" name="module_sixmoments_status" value="1"{% if module_sixmoments_status %} checked{% endif %}></div></div></div>
              <div class="row mb-3"><label class="col-sm-3 col-form-label">{{ entry_brand_name }}</label><div class="col-sm-9"><input class="form-control" name="module_sixmoments_brand_name" value="{{ module_sixmoments_brand_name }}" required><div class="form-text">{{ help_brand_name }}</div></div></div>
              <div class="row mb-3"><label class="col-sm-3 col-form-label">{{ entry_instagram }}</label><div class="col-sm-9"><input class="form-control" type="url" name="module_sixmoments_instagram" value="{{ module_sixmoments_instagram }}"></div></div>
              <div class="row mb-3"><label class="col-sm-3 col-form-label">{{ entry_email }}</label><div class="col-sm-9"><input class="form-control" type="email" name="module_sixmoments_email" value="{{ module_sixmoments_email }}"></div></div>
              <div class="row mb-3"><label class="col-sm-3 col-form-label">{{ entry_phone }}</label><div class="col-sm-9"><input class="form-control" name="module_sixmoments_phone" value="{{ module_sixmoments_phone }}"></div></div>
              <div class="row mb-3"><label class="col-sm-3 col-form-label">{{ entry_color_mode }}</label><div class="col-sm-9"><select class="form-select" name="module_sixmoments_color_mode"><option value="auto"{% if module_sixmoments_color_mode == 'auto' %} selected{% endif %}>Auto</option><option value="light"{% if module_sixmoments_color_mode == 'light' %} selected{% endif %}>Light</option><option value="dark"{% if module_sixmoments_color_mode == 'dark' %} selected{% endif %}>Dark</option></select><div class="form-text">{{ help_color_mode }}</div></div></div>
              <div class="card bg-light border-0 mt-4"><div class="card-body"><h5>{{ text_demo_title }}</h5><p>{{ text_demo_help }}</p>{% if demo_installed %}<span class="badge bg-success">{{ text_demo_installed }}</span>{% else %}<button type="submit" formaction="{{ install_demo }}" class="btn btn-warning" onclick="return confirm('{{ text_demo_confirm|escape('js') }}');"><i class="fa-solid fa-database"></i> {{ button_install_demo }}</button>{% endif %}</div></div>
            </section>

            <section class="tab-pane fade" id="tab-builder">
              <p class="text-muted">{{ help_page_builder }}</p>
              <input type="hidden" id="input-page-builder" name="module_sixmoments_page_builder" value="{{ module_sixmoments_page_builder|escape }}">
              <div id="six-builder" class="list-group mb-4"></div>
              <div class="row mb-3"><label class="col-sm-3 col-form-label">{{ entry_hero_kicker }}</label><div class="col-sm-9"><input class="form-control" name="module_sixmoments_hero_kicker" value="{{ module_sixmoments_hero_kicker }}" placeholder="{{ help_default_copy }}"></div></div>
              <div class="row mb-3"><label class="col-sm-3 col-form-label">{{ entry_hero_title }}</label><div class="col-sm-9"><input class="form-control" name="module_sixmoments_hero_title" value="{{ module_sixmoments_hero_title }}" placeholder="{{ help_default_copy }}"></div></div>
              <div class="row mb-3"><label class="col-sm-3 col-form-label">{{ entry_hero_cta }}</label><div class="col-sm-9"><input class="form-control" name="module_sixmoments_hero_cta" value="{{ module_sixmoments_hero_cta }}" placeholder="{{ help_default_copy }}"></div></div>
            </section>

            <section class="tab-pane fade" id="tab-navigation">
              <h4>{{ text_mega_menu }}</h4><p class="text-muted">{{ help_mega_menu }}</p>
              <div class="row mb-3"><label class="col-sm-3 col-form-label">{{ entry_mega_menu_status }}</label><div class="col-sm-9"><div class="form-check form-switch"><input type="hidden" name="module_sixmoments_mega_menu_status" value="0"><input class="form-check-input" type="checkbox" name="module_sixmoments_mega_menu_status" value="1"{% if module_sixmoments_mega_menu_status %} checked{% endif %}></div></div></div>
              <div class="row mb-3"><label class="col-sm-3 col-form-label">{{ entry_mega_menu_title }}</label><div class="col-sm-9"><input class="form-control" name="module_sixmoments_mega_menu_title" value="{{ module_sixmoments_mega_menu_title }}"></div></div>
              <div class="row mb-3"><label class="col-sm-3 col-form-label">{{ entry_mega_menu_promo_text }}</label><div class="col-sm-9"><input class="form-control" name="module_sixmoments_mega_menu_promo_text" value="{{ module_sixmoments_mega_menu_promo_text }}"></div></div>
              <div class="row mb-3"><label class="col-sm-3 col-form-label">{{ entry_mega_menu_promo_url }}</label><div class="col-sm-9"><input class="form-control" type="url" name="module_sixmoments_mega_menu_promo_url" value="{{ module_sixmoments_mega_menu_promo_url }}"></div></div>
              <div class="row mb-3"><label class="col-sm-3 col-form-label">{{ entry_native_menu_status }}</label><div class="col-sm-9"><div class="form-check form-switch"><input type="hidden" name="module_sixmoments_native_menu_status" value="0"><input class="form-check-input" type="checkbox" name="module_sixmoments_native_menu_status" value="1"{% if module_sixmoments_native_menu_status %} checked{% endif %}></div><div class="form-text">{{ help_native_menu }}</div></div></div>
              <div class="row mb-3"><label class="col-sm-3 col-form-label">{{ entry_blog_route }}</label><div class="col-sm-9"><input class="form-control font-monospace" name="module_sixmoments_blog_route" value="{{ module_sixmoments_blog_route }}" placeholder="cms/blog"><div class="form-text">{{ help_blog_route }}</div></div></div>
              <hr><h4>{{ text_ajax_filter }}</h4>
              <div class="row mb-3"><label class="col-sm-3 col-form-label">{{ entry_ajax_filter_status }}</label><div class="col-sm-9"><div class="form-check form-switch"><input type="hidden" name="module_sixmoments_ajax_filter_status" value="0"><input class="form-check-input" type="checkbox" name="module_sixmoments_ajax_filter_status" value="1"{% if module_sixmoments_ajax_filter_status %} checked{% endif %}></div><div class="form-text">{{ help_ajax_filter }}</div></div></div>
            </section>

            <section class="tab-pane fade" id="tab-ai">
              <div class="alert alert-secondary">{{ help_ai_privacy }}</div>
              <div class="row mb-3"><label class="col-sm-3 col-form-label">{{ entry_ai_endpoint }}</label><div class="col-sm-9"><input class="form-control" type="url" name="module_sixmoments_ai_endpoint" value="{{ module_sixmoments_ai_endpoint }}"></div></div>
              <div class="row mb-3"><label class="col-sm-3 col-form-label">{{ entry_ai_api_key }}</label><div class="col-sm-9"><input class="form-control" type="password" autocomplete="new-password" name="module_sixmoments_ai_api_key" value="" placeholder="{% if ai_key_configured %}•••••••• (configured){% endif %}"><div class="form-text">{{ help_ai_key }}</div></div></div>
              <div class="row mb-3"><label class="col-sm-3 col-form-label">{{ entry_ai_model }}</label><div class="col-sm-9"><input class="form-control" name="module_sixmoments_ai_model" value="{{ module_sixmoments_ai_model }}"></div></div>
              <div class="row mb-4"><label class="col-sm-3 col-form-label">{{ entry_ai_tone }}</label><div class="col-sm-9"><input class="form-control" name="module_sixmoments_ai_tone" value="{{ module_sixmoments_ai_tone }}"></div></div>
              <div class="card border-primary"><div class="card-header"><i class="fa-solid fa-wand-magic-sparkles"></i> {{ text_ai_product_tool }}</div><div class="card-body">
                <div class="row g-3"><div class="col-md-3"><label class="form-label">{{ entry_ai_product_id }}</label><input id="ai-product-id" class="form-control" type="number" min="1"></div><div class="col-md-3"><label class="form-label">{{ entry_ai_language_id }}</label><input id="ai-language-id" class="form-control" type="number" min="1" value="1"></div><div class="col-md-6 d-flex align-items-end gap-2"><button class="btn btn-primary" type="button" data-ai-generate="description">{{ button_ai_description }}</button><button class="btn btn-outline-primary" type="button" data-ai-generate="seo">{{ button_ai_seo }}</button></div></div>
                <div class="mt-3"><label class="form-label">{{ entry_ai_description }}</label><textarea id="ai-description" class="form-control font-monospace" rows="8"></textarea></div>
                <div class="row g-3 mt-1"><div class="col-md-4"><label class="form-label">Meta title</label><input id="ai-meta-title" class="form-control"></div><div class="col-md-4"><label class="form-label">Meta description</label><textarea id="ai-meta-description" class="form-control" rows="2"></textarea></div><div class="col-md-4"><label class="form-label">Meta keywords</label><input id="ai-meta-keyword" class="form-control"></div></div>
                <div class="d-flex align-items-center gap-3 mt-3"><button id="ai-apply" class="btn btn-success" type="button">{{ button_ai_apply }}</button><span id="ai-status" class="text-muted" role="status"></span></div>
              </div></div>
            </section>

            <section class="tab-pane fade" id="tab-commerce">
              <h4>{{ text_one_page_checkout }}</h4><div class="row mb-3"><label class="col-sm-3 col-form-label">{{ entry_one_page_checkout_status }}</label><div class="col-sm-9"><div class="form-check form-switch"><input type="hidden" name="module_sixmoments_one_page_checkout_status" value="0"><input class="form-check-input" type="checkbox" name="module_sixmoments_one_page_checkout_status" value="1"{% if module_sixmoments_one_page_checkout_status %} checked{% endif %}></div><div class="form-text">{{ help_one_page_checkout }}</div></div></div>
              <hr><h4>Stripe Checkout</h4>
              <div class="row mb-3"><label class="col-sm-3 col-form-label">{{ entry_stripe_key }}</label><div class="col-sm-9"><input class="form-control" type="password" autocomplete="new-password" name="payment_stripe_secret_key" value="{{ payment_stripe_secret_key }}"><div class="form-text">{{ help_stripe }}</div></div></div>
              <div class="row mb-3"><label class="col-sm-3 col-form-label">{{ entry_stripe_webhook }}</label><div class="col-sm-9"><input class="form-control" type="password" name="payment_stripe_webhook_secret" value="{{ payment_stripe_webhook_secret }}"><div class="form-text">Webhook URL: <code>{{ stripe_webhook_url }}</code></div></div></div>
              <div class="row mb-3"><label class="col-sm-3 col-form-label">{{ entry_stripe_status }}</label><div class="col-sm-9"><div class="form-check form-switch"><input type="hidden" name="payment_stripe_status" value="0"><input class="form-check-input" type="checkbox" name="payment_stripe_status" value="1"{% if payment_stripe_status %} checked{% endif %}></div></div></div>
              <hr><h4>DHL / DPD</h4><div class="row mb-3"><label class="col-sm-3 col-form-label">{{ entry_dhl_cost }}</label><div class="col-sm-9"><input class="form-control" type="number" step="0.01" name="shipping_dhl_cost" value="{{ shipping_dhl_cost }}"></div></div><div class="row mb-3"><label class="col-sm-3 col-form-label">{{ entry_dpd_cost }}</label><div class="col-sm-9"><input class="form-control" type="number" step="0.01" name="shipping_dpd_cost" value="{{ shipping_dpd_cost }}"></div></div>
            </section>

            <section class="tab-pane fade" id="tab-legal">
              <div class="alert alert-warning"><i class="fa-solid fa-triangle-exclamation"></i> {{ help_legal_details }}</div>
              {% set legal_fields = {'module_sixmoments_legal_name':entry_legal_name,'module_sixmoments_legal_form':entry_legal_form,'module_sixmoments_legal_representative':entry_legal_representative,'module_sixmoments_legal_register':entry_legal_register,'module_sixmoments_vat_id':entry_vat_id,'module_sixmoments_supervisory_authority':entry_supervisory_authority,'module_sixmoments_data_authority':entry_data_authority} %}
              {% for field,label in legal_fields %}<div class="row mb-3"><label class="col-sm-3 col-form-label">{{ label }}</label><div class="col-sm-9"><input class="form-control" name="{{ field }}" value="{{ attribute(_context, field) }}"></div></div>{% endfor %}
              <div class="row mb-3"><label class="col-sm-3 col-form-label">{{ entry_legal_address }}</label><div class="col-sm-9"><textarea class="form-control" rows="3" name="module_sixmoments_legal_address">{{ module_sixmoments_legal_address }}</textarea></div></div>
              <div class="row mb-3"><label class="col-sm-3 col-form-label">{{ entry_content_responsible }}</label><div class="col-sm-9"><textarea class="form-control" rows="2" name="module_sixmoments_content_responsible">{{ module_sixmoments_content_responsible }}</textarea></div></div>
              <div class="row mb-3"><label class="col-sm-3 col-form-label">{{ entry_privacy_email }}</label><div class="col-sm-9"><input class="form-control" type="email" name="module_sixmoments_privacy_email" value="{{ module_sixmoments_privacy_email }}"></div></div>
              <div class="row mb-3"><label class="col-sm-3 col-form-label">{{ entry_retention_periods }}</label><div class="col-sm-9"><textarea class="form-control" rows="4" name="module_sixmoments_retention_periods">{{ module_sixmoments_retention_periods }}</textarea></div></div>
              <hr><h4>{{ text_storefront_settings }}</h4><div class="row mb-3"><label class="col-sm-3 col-form-label">{{ entry_catalog_category }}</label><div class="col-sm-9"><input class="form-control" type="number" name="module_sixmoments_catalog_category_id" value="{{ module_sixmoments_catalog_category_id }}"></div></div><div class="row mb-3"><label class="col-sm-3 col-form-label">{{ entry_lab_category }}</label><div class="col-sm-9"><input class="form-control" type="number" name="module_sixmoments_lab_category_id" value="{{ module_sixmoments_lab_category_id }}"></div></div><div class="row mb-3"><label class="col-sm-3 col-form-label">{{ entry_quiz_rules }}</label><div class="col-sm-9"><textarea class="form-control font-monospace" rows="8" name="module_sixmoments_quiz_rules">{{ module_sixmoments_quiz_rules }}</textarea></div></div>
            </section>
          </div>
        </div>
      </div>
    </form>
  </div>
</div>
<script>
(() => {
  const labels = {hero:'Hero',featured:'Featured products',benefits:'Trust benefits',categories:'Category showcase',collections:'Collections',specials:'Sale carousel',story:'Brand story',journal:'Journal',social:'Social callout'};
  const input = document.querySelector('#input-page-builder');
  const root = document.querySelector('#six-builder');
  let blocks;
  try { blocks = JSON.parse(input.value || '[]'); } catch { blocks = []; }
  if (!Array.isArray(blocks) || !blocks.length) blocks = Object.keys(labels).map(id => ({id,enabled:1}));
  const draw = () => { root.innerHTML = blocks.map((block,index) => `<div class="list-group-item d-flex align-items-center gap-3" draggable="true" data-index="${index}"><span class="text-muted" title="Drag to reorder">☰</span><strong class="flex-grow-1">${labels[block.id] || block.id}</strong><div class="btn-group btn-group-sm"><button type="button" class="btn btn-light" data-up aria-label="Move up">↑</button><button type="button" class="btn btn-light" data-down aria-label="Move down">↓</button></div><div class="form-check form-switch"><input class="form-check-input" type="checkbox" data-enabled ${block.enabled ? 'checked' : ''}></div></div>`).join(''); input.value = JSON.stringify(blocks); };
  root.addEventListener('click', event => { const row=event.target.closest('[data-index]'); if(!row)return; const i=Number(row.dataset.index); const next=event.target.closest('[data-up]')?i-1:event.target.closest('[data-down]')?i+1:i; if(next!==i&&next>=0&&next<blocks.length){[blocks[i],blocks[next]]=[blocks[next],blocks[i]];draw();}});
  root.addEventListener('change', event => { if(event.target.matches('[data-enabled]')){blocks[Number(event.target.closest('[data-index]').dataset.index)].enabled=event.target.checked?1:0;input.value=JSON.stringify(blocks);}});
  let dragIndex=-1; root.addEventListener('dragstart',e=>{dragIndex=Number(e.target.closest('[data-index]').dataset.index)}); root.addEventListener('dragover',e=>e.preventDefault()); root.addEventListener('drop',e=>{e.preventDefault();const target=Number(e.target.closest('[data-index]').dataset.index);if(dragIndex>=0&&target!==dragIndex){const [item]=blocks.splice(dragIndex,1);blocks.splice(target,0,item);draw();}}); draw();

  const status=document.querySelector('#ai-status');
  async function post(url,data){const response=await fetch(url,{method:'POST',body:data,headers:{'X-Requested-With':'XMLHttpRequest'}});return response.json();}
  document.querySelectorAll('[data-ai-generate]').forEach(button=>button.addEventListener('click',async()=>{status.textContent='Generating…';button.disabled=true;const data=new FormData();data.set('product_id',document.querySelector('#ai-product-id').value);data.set('language_id',document.querySelector('#ai-language-id').value);data.set('mode',button.dataset.aiGenerate);try{const json=await post('{{ ai_generate }}',data);if(json.error)throw new Error(json.error);const result=json.result||{};if(result.description)document.querySelector('#ai-description').value=result.description;if(result.meta_title)document.querySelector('#ai-meta-title').value=result.meta_title;if(result.meta_description)document.querySelector('#ai-meta-description').value=result.meta_description;if(result.meta_keyword)document.querySelector('#ai-meta-keyword').value=result.meta_keyword;status.textContent='Draft ready. Review it before applying.';}catch(error){status.textContent=error.message;}finally{button.disabled=false;}}));
  document.querySelector('#ai-apply').addEventListener('click',async()=>{const data=new FormData();['product_id','language_id'].forEach(key=>data.set(key,document.querySelector('#ai-'+key.replace('_','-')).value));data.set('description',document.querySelector('#ai-description').value);data.set('meta_title',document.querySelector('#ai-meta-title').value);data.set('meta_description',document.querySelector('#ai-meta-description').value);data.set('meta_keyword',document.querySelector('#ai-meta-keyword').value);status.textContent='Applying…';try{const json=await post('{{ ai_apply }}',data);status.textContent=json.success||json.error;}catch{status.textContent='Request failed.';}});
})();
</script>
{{ footer }}
