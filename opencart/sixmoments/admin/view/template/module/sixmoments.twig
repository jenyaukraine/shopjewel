{{ header }}{{ column_left }}
<div id="content">
  <div class="page-header">
    <div class="container-fluid">
      <div class="float-end">
        <button type="submit" form="form-sixmoments" data-bs-toggle="tooltip" title="{{ button_save }}" class="btn btn-primary"><i class="fa-solid fa-save"></i></button>
        <a href="{{ back }}" data-bs-toggle="tooltip" title="{{ button_back }}" class="btn btn-light"><i class="fa-solid fa-reply"></i></a>
      </div>
      <h1>{{ heading_title }}</h1>
      <ol class="breadcrumb">{% for breadcrumb in breadcrumbs %}<li class="breadcrumb-item"><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>{% endfor %}</ol>
    </div>
  </div>
  <div class="container-fluid">
    <div class="alert alert-info"><i class="fa-solid fa-circle-info"></i> {{ text_installed }}</div>
    <div class="card">
      <div class="card-header"><i class="fa-solid fa-gem"></i> {{ text_edit }}</div>
      <div class="card-body">
        <form id="form-sixmoments" action="{{ save }}" method="post" data-oc-toggle="ajax">
          <div class="row mb-3"><label class="col-sm-3 col-form-label">{{ entry_status }}</label><div class="col-sm-9"><div class="form-check form-switch form-switch-lg"><input type="hidden" name="module_sixmoments_status" value="0"><input class="form-check-input" type="checkbox" name="module_sixmoments_status" value="1"{% if module_sixmoments_status %} checked{% endif %}></div></div></div>
          <div class="row mb-3"><label class="col-sm-3 col-form-label">{{ entry_instagram }}</label><div class="col-sm-9"><input class="form-control" name="module_sixmoments_instagram" value="{{ module_sixmoments_instagram }}"></div></div>
          <div class="row mb-3"><label class="col-sm-3 col-form-label">{{ entry_email }}</label><div class="col-sm-9"><input class="form-control" type="email" name="module_sixmoments_email" value="{{ module_sixmoments_email }}"></div></div>
          <div class="row mb-3"><label class="col-sm-3 col-form-label">{{ entry_phone }}</label><div class="col-sm-9"><input class="form-control" name="module_sixmoments_phone" value="{{ module_sixmoments_phone }}"></div></div>
          <hr><h4>{{ text_legal_details }}</h4>
          <div class="alert alert-warning"><i class="fa-solid fa-triangle-exclamation"></i> {{ help_legal_details }}</div>
          <div class="row mb-3"><label class="col-sm-3 col-form-label">{{ entry_legal_name }}</label><div class="col-sm-9"><input class="form-control" name="module_sixmoments_legal_name" value="{{ module_sixmoments_legal_name }}"></div></div>
          <div class="row mb-3"><label class="col-sm-3 col-form-label">{{ entry_legal_form }}</label><div class="col-sm-9"><input class="form-control" name="module_sixmoments_legal_form" value="{{ module_sixmoments_legal_form }}"></div></div>
          <div class="row mb-3"><label class="col-sm-3 col-form-label">{{ entry_legal_representative }}</label><div class="col-sm-9"><input class="form-control" name="module_sixmoments_legal_representative" value="{{ module_sixmoments_legal_representative }}"></div></div>
          <div class="row mb-3"><label class="col-sm-3 col-form-label">{{ entry_legal_address }}</label><div class="col-sm-9"><textarea class="form-control" rows="3" name="module_sixmoments_legal_address">{{ module_sixmoments_legal_address }}</textarea></div></div>
          <div class="row mb-3"><label class="col-sm-3 col-form-label">{{ entry_legal_register }}</label><div class="col-sm-9"><input class="form-control" name="module_sixmoments_legal_register" value="{{ module_sixmoments_legal_register }}"></div></div>
          <div class="row mb-3"><label class="col-sm-3 col-form-label">{{ entry_vat_id }}</label><div class="col-sm-9"><input class="form-control" name="module_sixmoments_vat_id" value="{{ module_sixmoments_vat_id }}"></div></div>
          <div class="row mb-3"><label class="col-sm-3 col-form-label">{{ entry_supervisory_authority }}</label><div class="col-sm-9"><input class="form-control" name="module_sixmoments_supervisory_authority" value="{{ module_sixmoments_supervisory_authority }}"></div></div>
          <div class="row mb-3"><label class="col-sm-3 col-form-label">{{ entry_content_responsible }}</label><div class="col-sm-9"><textarea class="form-control" rows="2" name="module_sixmoments_content_responsible">{{ module_sixmoments_content_responsible }}</textarea></div></div>
          <div class="row mb-3"><label class="col-sm-3 col-form-label">{{ entry_privacy_email }}</label><div class="col-sm-9"><input class="form-control" type="email" name="module_sixmoments_privacy_email" value="{{ module_sixmoments_privacy_email }}"></div></div>
          <div class="row mb-3"><label class="col-sm-3 col-form-label">{{ entry_data_authority }}</label><div class="col-sm-9"><input class="form-control" name="module_sixmoments_data_authority" value="{{ module_sixmoments_data_authority }}"></div></div>
          <div class="row mb-3"><label class="col-sm-3 col-form-label">{{ entry_retention_periods }}</label><div class="col-sm-9"><textarea class="form-control" rows="4" name="module_sixmoments_retention_periods">{{ module_sixmoments_retention_periods }}</textarea></div></div>
          <hr><h4>{{ text_storefront_settings }}</h4>
          <div class="row mb-3"><label class="col-sm-3 col-form-label">{{ entry_catalog_category }}</label><div class="col-sm-9"><input class="form-control" type="number" name="module_sixmoments_catalog_category_id" value="{{ module_sixmoments_catalog_category_id }}"></div></div>
          <div class="row mb-3"><label class="col-sm-3 col-form-label">{{ entry_lab_category }}</label><div class="col-sm-9"><input class="form-control" type="number" name="module_sixmoments_lab_category_id" value="{{ module_sixmoments_lab_category_id }}"></div></div>
          <div class="row mb-3"><label class="col-sm-3 col-form-label">{{ entry_quiz_rules }}</label><div class="col-sm-9"><textarea class="form-control font-monospace" rows="12" name="module_sixmoments_quiz_rules">{{ module_sixmoments_quiz_rules }}</textarea></div></div>
          <hr><h4>Stripe Checkout</h4>
          <div class="row mb-3"><label class="col-sm-3 col-form-label">{{ entry_stripe_key }}</label><div class="col-sm-9"><input class="form-control" type="password" autocomplete="new-password" name="payment_stripe_secret_key" value="{{ payment_stripe_secret_key }}"><div class="form-text">{{ help_stripe }}</div></div></div>
          <div class="row mb-3"><label class="col-sm-3 col-form-label">{{ entry_stripe_webhook }}</label><div class="col-sm-9"><input class="form-control" type="password" name="payment_stripe_webhook_secret" value="{{ payment_stripe_webhook_secret }}"><div class="form-text">Webhook URL: <code>{{ stripe_webhook_url }}</code></div></div></div>
          <div class="row mb-3"><label class="col-sm-3 col-form-label">{{ entry_stripe_status }}</label><div class="col-sm-9"><div class="form-check form-switch"><input type="hidden" name="payment_stripe_status" value="0"><input class="form-check-input" type="checkbox" name="payment_stripe_status" value="1"{% if payment_stripe_status %} checked{% endif %}></div></div></div>
          <hr><h4>DHL / DPD</h4>
          <div class="row mb-3"><label class="col-sm-3 col-form-label">{{ entry_dhl_cost }}</label><div class="col-sm-9"><input class="form-control" type="number" step="0.01" name="shipping_dhl_cost" value="{{ shipping_dhl_cost }}"></div></div>
          <div class="row mb-3"><label class="col-sm-3 col-form-label">{{ entry_dpd_cost }}</label><div class="col-sm-9"><input class="form-control" type="number" step="0.01" name="shipping_dpd_cost" value="{{ shipping_dpd_cost }}"></div></div>
        </form>
      </div>
    </div>
  </div>
</div>
{{ footer }}
