{{ header }}{{ column_left }}
<div id="content">
<style>
  .noveraile-admin { --nv-ink:#17201d; --nv-muted:#66736e; --nv-line:#dfe7e3; --nv-soft:#f4f7f5; --nv-accent:#245f4d; }
  .noveraile-admin .noveraile-hero { background:linear-gradient(135deg,#17201d 0%,#264f42 100%); color:#fff; border:0; overflow:hidden; position:relative; }
  .noveraile-admin .noveraile-hero::after { content:""; position:absolute; width:260px; height:260px; border:1px solid rgba(255,255,255,.15); border-radius:50%; right:-70px; top:-145px; }
  .noveraile-admin .noveraile-hero p { color:rgba(255,255,255,.72); max-width:760px; }
  .noveraile-admin .suite-version { display:inline-flex; align-items:center; gap:.5rem; padding:.4rem .75rem; border:1px solid rgba(255,255,255,.24); border-radius:999px; background:rgba(255,255,255,.08); font-size:.78rem; }
  .noveraile-admin .nav-tabs { gap:.35rem; padding:.75rem .75rem 0; background:var(--nv-soft); border-bottom-color:var(--nv-line); overflow-x:auto; flex-wrap:nowrap; }
  .noveraile-admin .nav-tabs .nav-link { color:var(--nv-muted); border:0; border-radius:.6rem .6rem 0 0; white-space:nowrap; padding:.75rem .9rem; }
  .noveraile-admin .nav-tabs .nav-link.active { color:var(--nv-ink); font-weight:700; box-shadow:inset 0 -2px var(--nv-accent); }
  .noveraile-admin .catalog-stat { border:1px solid var(--nv-line); border-radius:.85rem; padding:1rem 1.1rem; background:#fff; }
  .noveraile-admin .catalog-stat strong { display:block; color:var(--nv-ink); font-size:1.6rem; line-height:1.1; }
  .noveraile-admin .catalog-stat span { color:var(--nv-muted); font-size:.78rem; text-transform:uppercase; letter-spacing:.06em; }
  .noveraile-admin .catalog-action-card { border:1px solid var(--nv-line); border-radius:1rem; height:100%; padding:1.35rem; background:#fff; }
  .noveraile-admin .catalog-drop { display:block; border:2px dashed #b7c8c1; border-radius:.85rem; padding:1.4rem; text-align:center; cursor:pointer; background:var(--nv-soft); transition:.2s ease; }
  .noveraile-admin .catalog-drop:hover,.noveraile-admin .catalog-drop.is-dragging { border-color:var(--nv-accent); background:#eaf2ee; }
  .noveraile-admin .catalog-drop i { display:block; color:var(--nv-accent); font-size:1.65rem; margin-bottom:.55rem; }
  .noveraile-admin .catalog-preview { max-height:220px; overflow:auto; border:1px solid var(--nv-line); border-radius:.75rem; }
  .noveraile-admin .catalog-preview table { margin:0; font-size:.82rem; }
  .noveraile-admin .catalog-preview th { position:sticky; top:0; background:var(--nv-soft); }
  @media (max-width:767px) { .noveraile-admin .catalog-action-card { padding:1rem; } .noveraile-admin .nav-tabs { margin:0 -.75rem; } }
</style>
  <div class="page-header"><div class="container-fluid">
    <div class="float-end"><button type="submit" form="form-noveraile" data-bs-toggle="tooltip" title="{{ button_save }}" class="btn btn-primary"><i class="fa-solid fa-save"></i></button><a href="{{ back }}" data-bs-toggle="tooltip" title="{{ button_back }}" class="btn btn-light"><i class="fa-solid fa-reply"></i></a></div>
    <h1>{{ heading_title }}</h1><ol class="breadcrumb">{% for breadcrumb in breadcrumbs %}<li class="breadcrumb-item"><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>{% endfor %}</ol>
  </div></div>
  <div class="container-fluid noveraile-admin">
    {% if success %}<div class="alert alert-success alert-dismissible"><i class="fa-solid fa-circle-check"></i> {{ success }}<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>{% endif %}
    {% if error_warning %}<div class="alert alert-danger alert-dismissible"><i class="fa-solid fa-circle-exclamation"></i> {{ error_warning }}<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>{% endif %}
    <div class="card noveraile-hero mb-3"><div class="card-body p-4 p-lg-5">
      <div class="d-flex flex-wrap align-items-start justify-content-between gap-3"><div><span class="suite-version"><i class="fa-solid fa-circle-check"></i> v{{ noveraile_version }} · OpenCart {{ opencart_version }}</span><h2 class="mt-3 mb-2">{{ text_edit }}</h2><p class="mb-0">{{ text_installed }}</p></div><div class="d-flex gap-2"><a class="btn btn-light" href="{{ catalog_export }}"><i class="fa-solid fa-file-export"></i> {{ button_catalog_export }}</a><button class="btn btn-outline-light" type="submit" form="form-noveraile"><i class="fa-solid fa-check"></i> {{ button_save }}</button></div></div>
    </div></div>
    <form id="form-catalog-import" action="{{ catalog_import }}" method="post" enctype="multipart/form-data"></form>
    <form id="form-noveraile" action="{{ save }}" method="post" data-oc-toggle="ajax">
      <div class="card">
        <div class="card-header d-flex align-items-center justify-content-between"><span><i class="fa-solid fa-gem"></i> {{ text_edit }}</span><span class="badge bg-dark">v{{ noveraile_version }}</span></div>
        <div class="card-body">
          <ul class="nav nav-tabs" role="tablist">
            <li class="nav-item"><button class="nav-link active" data-bs-toggle="tab" data-bs-target="#tab-general" type="button">{{ text_general }}</button></li>
            <li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#tab-catalog" type="button"><i class="fa-solid fa-arrows-rotate me-1"></i>{{ text_catalog }}</button></li>
            <li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#tab-feed" type="button"><i class="fa-solid fa-truck-ramp-box me-1"></i>{{ text_feed }}</button></li>
            <li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#tab-builder" type="button">{{ text_page_builder }}</button></li>
            <li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#tab-navigation" type="button">{{ text_navigation }}</button></li>
            <li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#tab-ai" type="button">{{ text_ai_studio }}</button></li>
            <li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#tab-commerce" type="button">{{ text_commerce }}</button></li>
            <li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#tab-legal" type="button">{{ text_legal_details }}</button></li>
          </ul>
          <div class="tab-content pt-4">
            <section class="tab-pane fade show active" id="tab-general">
              <div class="row mb-3"><label class="col-sm-3 col-form-label">{{ entry_status }}</label><div class="col-sm-9"><div class="form-check form-switch form-switch-lg"><input type="hidden" name="module_noveraile_status" value="0"><input class="form-check-input" type="checkbox" name="module_noveraile_status" value="1"{% if module_noveraile_status %} checked{% endif %}></div></div></div>
              <div class="row mb-3"><label class="col-sm-3 col-form-label">{{ entry_brand_name }}</label><div class="col-sm-9"><input class="form-control" name="module_noveraile_brand_name" value="{{ module_noveraile_brand_name }}" required><div class="form-text">{{ help_brand_name }}</div></div></div>
              <div class="row mb-3"><label class="col-sm-3 col-form-label">{{ entry_logo }}</label><div class="col-sm-9"><div class="d-flex align-items-center gap-3"><a href="{{ logo_thumb }}" id="thumb-noveraile-logo" data-oc-toggle="image" data-oc-target="input-noveraile-logo" data-oc-thumb="thumb-noveraile-logo" data-oc-placeholder="{{ logo_placeholder }}" class="img-thumbnail"><img src="{{ logo_thumb }}" alt="" title="" id="noveraile-logo"></a><input type="hidden" name="module_noveraile_logo" value="{{ module_noveraile_logo }}" id="input-noveraile-logo"></div><div class="form-text">{{ help_logo }}</div></div></div>
              <div class="row mb-3"><label class="col-sm-3 col-form-label">{{ entry_instagram }}</label><div class="col-sm-9"><input class="form-control" type="url" name="module_noveraile_instagram" value="{{ module_noveraile_instagram }}"></div></div>
              <div class="row mb-3"><label class="col-sm-3 col-form-label">{{ entry_email }}</label><div class="col-sm-9"><input class="form-control" type="email" name="module_noveraile_email" value="{{ module_noveraile_email }}"></div></div>
              <div class="row mb-3"><label class="col-sm-3 col-form-label">{{ entry_phone }}</label><div class="col-sm-9"><input class="form-control" name="module_noveraile_phone" value="{{ module_noveraile_phone }}"></div></div>
              <div class="row mb-3"><label class="col-sm-3 col-form-label">{{ entry_whatsapp }}</label><div class="col-sm-9"><input class="form-control" type="url" name="module_noveraile_whatsapp" value="{{ module_noveraile_whatsapp }}"></div></div>
              <div class="row mb-3"><label class="col-sm-3 col-form-label">{{ entry_telegram }}</label><div class="col-sm-9"><input class="form-control" type="url" name="module_noveraile_telegram" value="{{ module_noveraile_telegram }}"></div></div>
              <div class="row mb-3"><label class="col-sm-3 col-form-label">{{ entry_facebook }}</label><div class="col-sm-9"><input class="form-control" type="url" name="module_noveraile_facebook" value="{{ module_noveraile_facebook }}"></div></div>
              <div class="card bg-light border-0 mt-4"><div class="card-body"><h5>{{ text_demo_title }}</h5><p>{{ text_demo_help }}</p>{% if demo_installed %}<span class="badge bg-success">{{ text_demo_installed }}</span>{% else %}<button type="submit" formaction="{{ install_demo }}" class="btn btn-warning" onclick="return confirm('{{ text_demo_confirm|escape('js') }}');"><i class="fa-solid fa-database"></i> {{ button_install_demo }}</button>{% endif %}</div></div>
            </section>

            <section class="tab-pane fade" id="tab-catalog">
              <div class="d-flex flex-wrap align-items-start justify-content-between gap-3 mb-4"><div><h3 class="mb-1">{{ text_catalog_title }}</h3><p class="text-muted mb-0">{{ text_catalog_help }}</p></div><a class="btn btn-outline-secondary" href="{{ catalog_template }}"><i class="fa-regular fa-file-lines"></i> {{ button_catalog_template }}</a></div>
              <div class="row g-3 mb-4">
                <div class="col-4"><div class="catalog-stat"><strong>{{ catalog_summary.total }}</strong><span>{{ text_catalog_total }}</span></div></div>
                <div class="col-4"><div class="catalog-stat"><strong>{{ catalog_summary.active }}</strong><span>{{ text_catalog_active }}</span></div></div>
                <div class="col-4"><div class="catalog-stat"><strong>{{ catalog_summary.languages }}</strong><span>{{ text_catalog_languages }}</span></div></div>
              </div>
              <div class="row g-3">
                <div class="col-lg-5"><div class="catalog-action-card d-flex flex-column">
                  <span class="badge text-bg-success align-self-start mb-3"><i class="fa-solid fa-shield-halved"></i> CSV UTF-8</span>
                  <h4>{{ text_catalog_export_title }}</h4><p class="text-muted flex-grow-1">{{ text_catalog_export_help }}</p>
                  <a class="btn btn-primary btn-lg" href="{{ catalog_export }}"><i class="fa-solid fa-download"></i> {{ button_catalog_export }}</a>
                </div></div>
                <div class="col-lg-7"><div class="catalog-action-card">
                  <h4>{{ text_catalog_import_title }}</h4><p class="text-muted">{{ text_catalog_import_help }}</p>
                  <input class="visually-hidden" id="input-catalog-file" type="file" name="catalog_file" accept=".csv,text/csv" required form="form-catalog-import">
                  <label class="catalog-drop mb-3" id="catalog-drop" for="input-catalog-file"><i class="fa-solid fa-cloud-arrow-up"></i><strong class="d-block" id="catalog-file-label">{{ text_catalog_drop }}</strong><span class="text-muted">{{ text_catalog_browse }}</span></label>
                  <div class="catalog-preview mb-3" id="catalog-preview"><p class="text-muted text-center p-3 mb-0">{{ text_catalog_preview_empty }}</p></div>
                  <div class="form-check mb-3"><input class="form-check-input" id="input-update-existing" type="checkbox" name="update_existing" value="1" checked form="form-catalog-import"><label class="form-check-label" for="input-update-existing"><strong>{{ text_catalog_update_existing }}</strong><small class="d-block text-muted">{{ text_catalog_update_help }}</small></label></div>
                  <div class="alert alert-light border py-2"><i class="fa-solid fa-lock text-success"></i> {{ text_catalog_import_notice }}</div>
                  <button class="btn btn-success btn-lg w-100" type="submit" form="form-catalog-import" id="button-catalog-import" disabled><i class="fa-solid fa-file-import"></i> {{ button_catalog_import }}</button>
                </div></div>
              </div>
            </section>

            <section class="tab-pane fade" id="tab-feed">
              <div class="mb-4"><h3 class="mb-1">{{ text_feed_title }}</h3><p class="text-muted mb-0">{{ text_feed_help }}</p></div>
              <div class="row g-3">
                <div class="col-lg-6"><div class="catalog-action-card">
                  <input class="visually-hidden" id="input-feed-file" type="file" name="feed_file" accept=".csv,text/csv">
                  <label class="catalog-drop mb-3" for="input-feed-file"><i class="fa-solid fa-cloud-arrow-up"></i><strong class="d-block" id="feed-file-label">{{ text_feed_drop }}</strong><span class="text-muted">{{ text_feed_browse }}</span></label>
                  <div class="alert alert-light border py-2"><i class="fa-solid fa-circle-info text-primary"></i> {{ text_feed_notice }}</div>
                  <div class="d-flex gap-2">
                    <button class="btn btn-success btn-lg flex-grow-1" type="button" id="button-feed-import" disabled><i class="fa-solid fa-file-import"></i> {{ button_feed_import }}</button>
                    <button class="btn btn-outline-danger btn-lg d-none" type="button" id="button-feed-cancel">{{ button_feed_cancel }}</button>
                    <button class="btn btn-outline-primary btn-lg d-none" type="button" id="button-feed-resume">{{ button_feed_resume }}</button>
                  </div>
                </div></div>
                <div class="col-lg-6"><div class="catalog-action-card">
                  <h4 class="h6 text-uppercase text-muted">{{ text_feed_last_run }}</h4>
                  <div class="progress mb-3" style="height:1.5rem"><div class="progress-bar progress-bar-striped" id="feed-progress-bar" role="progressbar" style="width:0%">0%</div></div>
                  <p class="mb-3" id="feed-progress-text">{{ text_feed_idle }}</p>
                  <div class="row g-2 text-center">
                    <div class="col-4"><div class="catalog-stat"><strong id="feed-stat-created">0</strong><span>{{ text_feed_created }}</span></div></div>
                    <div class="col-4"><div class="catalog-stat"><strong id="feed-stat-updated">0</strong><span>{{ text_feed_updated }}</span></div></div>
                    <div class="col-4"><div class="catalog-stat"><strong id="feed-stat-images">0</strong><span>{{ text_feed_images }}</span></div></div>
                    <div class="col-6"><div class="catalog-stat"><strong id="feed-stat-failed">0</strong><span>{{ text_feed_failed }}</span></div></div>
                    <div class="col-6"><div class="catalog-stat"><strong id="feed-stat-retired">0</strong><span>{{ text_feed_retired }}</span></div></div>
                  </div>
                  <div class="mt-3 d-none" id="feed-failures"><h5 class="h6">{{ text_feed_failures }}</h5><ul class="small text-danger mb-0" id="feed-failure-list"></ul></div>
                </div></div>
              </div>
            </section>

            <section class="tab-pane fade" id="tab-builder">
              <p class="text-muted">{{ help_page_builder }}</p>
              <input type="hidden" id="input-page-builder" name="module_noveraile_page_builder" value="{{ module_noveraile_page_builder|escape }}">
              <div id="six-builder" class="list-group mb-4"></div>
              <div class="row mb-3"><label class="col-sm-3 col-form-label">{{ entry_hero_kicker }}</label><div class="col-sm-9"><input class="form-control" name="module_noveraile_hero_kicker" value="{{ module_noveraile_hero_kicker }}" placeholder="{{ help_default_copy }}"></div></div>
              <div class="row mb-3"><label class="col-sm-3 col-form-label">{{ entry_hero_title }}</label><div class="col-sm-9"><input class="form-control" name="module_noveraile_hero_title" value="{{ module_noveraile_hero_title }}" placeholder="{{ help_default_copy }}"></div></div>
              <div class="row mb-3"><label class="col-sm-3 col-form-label">{{ entry_hero_cta }}</label><div class="col-sm-9"><input class="form-control" name="module_noveraile_hero_cta" value="{{ module_noveraile_hero_cta }}" placeholder="{{ help_default_copy }}"></div></div>
            </section>

            <section class="tab-pane fade" id="tab-navigation">
              <h4>{{ text_mega_menu }}</h4><p class="text-muted">{{ help_mega_menu }}</p>
              <div class="row mb-3"><label class="col-sm-3 col-form-label">{{ entry_mega_menu_status }}</label><div class="col-sm-9"><div class="form-check form-switch"><input type="hidden" name="module_noveraile_mega_menu_status" value="0"><input class="form-check-input" type="checkbox" name="module_noveraile_mega_menu_status" value="1"{% if module_noveraile_mega_menu_status %} checked{% endif %}></div></div></div>
              <div class="row mb-3"><label class="col-sm-3 col-form-label">{{ entry_mega_menu_title }}</label><div class="col-sm-9"><input class="form-control" name="module_noveraile_mega_menu_title" value="{{ module_noveraile_mega_menu_title }}"></div></div>
              <div class="row mb-3"><label class="col-sm-3 col-form-label">{{ entry_mega_menu_promo_text }}</label><div class="col-sm-9"><input class="form-control" name="module_noveraile_mega_menu_promo_text" value="{{ module_noveraile_mega_menu_promo_text }}"></div></div>
              <div class="row mb-3"><label class="col-sm-3 col-form-label">{{ entry_mega_menu_promo_url }}</label><div class="col-sm-9"><input class="form-control" type="url" name="module_noveraile_mega_menu_promo_url" value="{{ module_noveraile_mega_menu_promo_url }}"></div></div>
              <div class="row mb-3"><label class="col-sm-3 col-form-label">{{ entry_native_menu_status }}</label><div class="col-sm-9"><div class="form-check form-switch"><input type="hidden" name="module_noveraile_native_menu_status" value="0"><input class="form-check-input" type="checkbox" name="module_noveraile_native_menu_status" value="1"{% if module_noveraile_native_menu_status %} checked{% endif %}></div><div class="form-text">{{ help_native_menu }}</div></div></div>
              <div class="row mb-3"><label class="col-sm-3 col-form-label">{{ entry_blog_route }}</label><div class="col-sm-9"><input class="form-control font-monospace" name="module_noveraile_blog_route" value="{{ module_noveraile_blog_route }}" placeholder="cms/blog"><div class="form-text">{{ help_blog_route }}</div></div></div>
              <hr><h4>{{ text_ajax_filter }}</h4>
              <div class="row mb-3"><label class="col-sm-3 col-form-label">{{ entry_ajax_filter_status }}</label><div class="col-sm-9"><div class="form-check form-switch"><input type="hidden" name="module_noveraile_ajax_filter_status" value="0"><input class="form-check-input" type="checkbox" name="module_noveraile_ajax_filter_status" value="1"{% if module_noveraile_ajax_filter_status %} checked{% endif %}></div><div class="form-text">{{ help_ajax_filter }}</div></div></div>
            </section>

            <section class="tab-pane fade" id="tab-ai">
              <div class="alert alert-secondary">{{ help_ai_privacy }}</div>
              <div class="row mb-3"><label class="col-sm-3 col-form-label">{{ entry_ai_endpoint }}</label><div class="col-sm-9"><input class="form-control" type="url" name="module_noveraile_ai_endpoint" value="{{ module_noveraile_ai_endpoint }}"></div></div>
              <div class="row mb-3"><label class="col-sm-3 col-form-label">{{ entry_ai_api_key }}</label><div class="col-sm-9"><input class="form-control" type="password" autocomplete="new-password" name="module_noveraile_ai_api_key" value="" placeholder="{% if ai_key_configured %}•••••••• (configured){% endif %}"><div class="form-text">{{ help_ai_key }}</div></div></div>
              <div class="row mb-3"><label class="col-sm-3 col-form-label">{{ entry_ai_model }}</label><div class="col-sm-9"><input class="form-control" name="module_noveraile_ai_model" value="{{ module_noveraile_ai_model }}"></div></div>
              <div class="row mb-4"><label class="col-sm-3 col-form-label">{{ entry_ai_tone }}</label><div class="col-sm-9"><input class="form-control" name="module_noveraile_ai_tone" value="{{ module_noveraile_ai_tone }}"></div></div>
              <div class="card border-primary"><div class="card-header"><i class="fa-solid fa-wand-magic-sparkles"></i> {{ text_ai_product_tool }}</div><div class="card-body">
                <div class="row g-3"><div class="col-md-3"><label class="form-label">{{ entry_ai_product_id }}</label><input id="ai-product-id" class="form-control" type="number" min="1"></div><div class="col-md-3"><label class="form-label">{{ entry_ai_language_id }}</label><input id="ai-language-id" class="form-control" type="number" min="1" value="1"></div><div class="col-md-6 d-flex align-items-end gap-2"><button class="btn btn-primary" type="button" data-ai-generate="description">{{ button_ai_description }}</button><button class="btn btn-outline-primary" type="button" data-ai-generate="seo">{{ button_ai_seo }}</button></div></div>
                <div class="mt-3"><label class="form-label">{{ entry_ai_description }}</label><textarea id="ai-description" class="form-control font-monospace" rows="8"></textarea></div>
                <div class="row g-3 mt-1"><div class="col-md-4"><label class="form-label">Meta title</label><input id="ai-meta-title" class="form-control"></div><div class="col-md-4"><label class="form-label">Meta description</label><textarea id="ai-meta-description" class="form-control" rows="2"></textarea></div><div class="col-md-4"><label class="form-label">Meta keywords</label><input id="ai-meta-keyword" class="form-control"></div></div>
                <div class="d-flex align-items-center gap-3 mt-3"><button id="ai-apply" class="btn btn-success" type="button">{{ button_ai_apply }}</button><span id="ai-status" class="text-muted" role="status"></span></div>
              </div></div>
            </section>

            <section class="tab-pane fade" id="tab-commerce">
              <h4>{{ text_one_page_checkout }}</h4><div class="row mb-3"><label class="col-sm-3 col-form-label">{{ entry_one_page_checkout_status }}</label><div class="col-sm-9"><div class="form-check form-switch"><input type="hidden" name="module_noveraile_one_page_checkout_status" value="0"><input class="form-check-input" type="checkbox" name="module_noveraile_one_page_checkout_status" value="1"{% if module_noveraile_one_page_checkout_status %} checked{% endif %}></div><div class="form-text">{{ help_one_page_checkout }}</div></div></div>
              <hr><h4>Stripe Checkout</h4>
              <div class="row mb-3"><label class="col-sm-3 col-form-label">{{ entry_stripe_key }}</label><div class="col-sm-9"><input class="form-control" type="password" autocomplete="new-password" name="payment_stripe_secret_key" value="" placeholder="{% if stripe_key_configured %}Configured — leave blank to keep{% endif %}"><div class="form-text">{{ help_stripe }}</div></div></div>
              <div class="row mb-3"><label class="col-sm-3 col-form-label">{{ entry_stripe_webhook }}</label><div class="col-sm-9"><input class="form-control" type="password" autocomplete="new-password" name="payment_stripe_webhook_secret" value="" placeholder="{% if stripe_webhook_configured %}Configured — leave blank to keep{% endif %}"><div class="form-text">Webhook URL: <code>{{ stripe_webhook_url }}</code></div></div></div>
              <div class="row mb-3"><label class="col-sm-3 col-form-label">{{ entry_stripe_status }}</label><div class="col-sm-9"><div class="form-check form-switch"><input type="hidden" name="payment_stripe_status" value="0"><input class="form-check-input" type="checkbox" name="payment_stripe_status" value="1"{% if payment_stripe_status %} checked{% endif %}></div></div></div>
              <hr><h4>DHL / DPD</h4>
              <div class="row mb-3"><label class="col-sm-3 col-form-label">{{ entry_dhl_cost }}</label><div class="col-sm-9"><input class="form-control" type="number" step="0.01" name="shipping_dhl_cost" value="{{ shipping_dhl_cost }}"><div class="form-text">{{ help_shipping_fallback }}</div></div></div>
              <div class="row mb-3"><label class="col-sm-3 col-form-label">{{ entry_dpd_cost }}</label><div class="col-sm-9"><input class="form-control" type="number" step="0.01" name="shipping_dpd_cost" value="{{ shipping_dpd_cost }}"></div></div>
              <div class="alert alert-light border"><strong>{{ text_geo_zones }}</strong><ul class="mb-0 small">{% for zone in geo_zones %}<li><code>{{ zone.geo_zone_id }}</code> — {{ zone.name }}</li>{% endfor %}</ul></div>
              <div class="row mb-3"><label class="col-sm-3 col-form-label">{{ entry_dhl_tiers }}</label><div class="col-sm-9"><textarea class="form-control font-monospace" rows="6" name="shipping_dhl_tiers">{{ shipping_dhl_tiers }}</textarea><div class="form-text">{{ help_shipping_tiers }}</div></div></div>
              <div class="row mb-3"><label class="col-sm-3 col-form-label">{{ entry_dpd_tiers }}</label><div class="col-sm-9"><textarea class="form-control font-monospace" rows="6" name="shipping_dpd_tiers">{{ shipping_dpd_tiers }}</textarea></div></div>
            </section>

            <section class="tab-pane fade" id="tab-legal">
              <div class="alert alert-warning"><i class="fa-solid fa-triangle-exclamation"></i> {{ help_legal_details }}</div>
              {% set legal_fields = {'module_noveraile_legal_name':entry_legal_name,'module_noveraile_legal_form':entry_legal_form,'module_noveraile_legal_representative':entry_legal_representative,'module_noveraile_legal_register':entry_legal_register,'module_noveraile_vat_id':entry_vat_id,'module_noveraile_supervisory_authority':entry_supervisory_authority,'module_noveraile_data_authority':entry_data_authority} %}
              {% for field,label in legal_fields %}<div class="row mb-3"><label class="col-sm-3 col-form-label">{{ label }}</label><div class="col-sm-9"><input class="form-control" name="{{ field }}" value="{{ attribute(_context, field) }}"></div></div>{% endfor %}
              <div class="row mb-3"><label class="col-sm-3 col-form-label">{{ entry_legal_address }}</label><div class="col-sm-9"><textarea class="form-control" rows="3" name="module_noveraile_legal_address">{{ module_noveraile_legal_address }}</textarea></div></div>
              <div class="row mb-3"><label class="col-sm-3 col-form-label">{{ entry_content_responsible }}</label><div class="col-sm-9"><textarea class="form-control" rows="2" name="module_noveraile_content_responsible">{{ module_noveraile_content_responsible }}</textarea></div></div>
              <div class="row mb-3"><label class="col-sm-3 col-form-label">{{ entry_privacy_email }}</label><div class="col-sm-9"><input class="form-control" type="email" name="module_noveraile_privacy_email" value="{{ module_noveraile_privacy_email }}"></div></div>
              <div class="row mb-3"><label class="col-sm-3 col-form-label">{{ entry_retention_periods }}</label><div class="col-sm-9"><textarea class="form-control" rows="4" name="module_noveraile_retention_periods">{{ module_noveraile_retention_periods }}</textarea></div></div>
              <hr><h4>{{ text_storefront_settings }}</h4><div class="row mb-3"><label class="col-sm-3 col-form-label">{{ entry_catalog_category }}</label><div class="col-sm-9"><input class="form-control" type="number" name="module_noveraile_catalog_category_id" value="{{ module_noveraile_catalog_category_id }}"></div></div><div class="row mb-3"><label class="col-sm-3 col-form-label">{{ entry_lab_category }}</label><div class="col-sm-9"><input class="form-control" type="number" name="module_noveraile_lab_category_id" value="{{ module_noveraile_lab_category_id }}"></div></div><div class="row mb-3"><label class="col-sm-3 col-form-label">{{ entry_quiz_rules }}</label><div class="col-sm-9"><textarea class="form-control font-monospace" rows="8" name="module_noveraile_quiz_rules">{{ module_noveraile_quiz_rules }}</textarea></div></div><div class="row mb-3"><label class="col-sm-3 col-form-label">{{ entry_price_book }}</label><div class="col-sm-9"><textarea class="form-control font-monospace" rows="12" name="module_noveraile_price_book">{{ module_noveraile_price_book }}</textarea><div class="form-text">{{ help_price_book }}</div></div></div>
            </section>
          </div>
        </div>
      </div>
    </form>
    <div class="card mt-3">
      <div class="card-header"><i class="fa-solid fa-cloud-arrow-up"></i> {{ text_update_title }}</div>
      <div class="card-body">
        <p class="text-muted">{{ help_update }}</p>
        <form action="{{ update }}" method="post" enctype="multipart/form-data" class="row g-3 align-items-end">
          <div class="col-lg-9"><label class="form-label" for="input-update-file">{{ entry_update_file }}</label><input id="input-update-file" class="form-control" type="file" name="file" accept=".zip,.ocmod.zip" required></div>
          <div class="col-lg-3"><button class="btn btn-primary w-100" type="submit"><i class="fa-solid fa-arrow-up-from-bracket"></i> {{ button_update }}</button></div>
        </form>
      </div>
    </div>
  </div>
</div>
<script>
(() => {
  const labels = {hero:'Hero',featured:'Featured products',benefits:'Trust benefits',categories:'Category showcase',collections:'Collections',specials:'Sale carousel',story:'Brand story',journal:'Journal',social:'Social callout'};
  const input = document.querySelector('#input-page-builder');
  const root = document.querySelector('#six-builder');
  let blocks;
  try { blocks = JSON.parse(input.value || '[]'); } catch { blocks = []; }
  if (!Array.isArray(blocks) || !blocks.length) blocks = Object.keys(labels).map(id => ({id,enabled:1}));
  const draw = () => { root.innerHTML = blocks.map((block,index) => `<div class="list-group-item d-flex align-items-center gap-3" draggable="true" data-index="${index}"><span class="text-muted" title="Drag to reorder">☰</span><strong class="flex-grow-1">${labels[block.id] || block.id}</strong><div class="btn-group btn-group-sm"><button type="button" class="btn btn-light" data-up aria-label="Move up">↑</button><button type="button" class="btn btn-light" data-down aria-label="Move down">↓</button></div><div class="form-check form-switch"><input class="form-check-input" type="checkbox" data-enabled ${block.enabled ? 'checked' : ''}></div></div>`).join(''); input.value = JSON.stringify(blocks); };
  root.addEventListener('click', event => { const row=event.target.closest('[data-index]'); if(!row)return; const i=Number(row.dataset.index); const next=event.target.closest('[data-up]')?i-1:event.target.closest('[data-down]')?i+1:i; if(next!==i&&next>=0&&next<blocks.length){[blocks[i],blocks[next]]=[blocks[next],blocks[i]];draw();}});
  root.addEventListener('change', event => { if(event.target.matches('[data-enabled]')){blocks[Number(event.target.closest('[data-index]').dataset.index)].enabled=event.target.checked?1:0;input.value=JSON.stringify(blocks);}});
  let dragIndex=-1; root.addEventListener('dragstart',e=>{dragIndex=Number(e.target.closest('[data-index]').dataset.index)}); root.addEventListener('dragover',e=>e.preventDefault()); root.addEventListener('drop',e=>{e.preventDefault();const target=Number(e.target.closest('[data-index]').dataset.index);if(dragIndex>=0&&target!==dragIndex){const [item]=blocks.splice(dragIndex,1);blocks.splice(target,0,item);draw();}}); draw();

  const status=document.querySelector('#ai-status');
  async function post(url,data){const response=await fetch(url,{method:'POST',body:data,headers:{'X-Requested-With':'XMLHttpRequest'}});return response.json();}
  document.querySelectorAll('[data-ai-generate]').forEach(button=>button.addEventListener('click',async()=>{status.textContent='Generating…';button.disabled=true;const data=new FormData();data.set('product_id',document.querySelector('#ai-product-id').value);data.set('language_id',document.querySelector('#ai-language-id').value);data.set('mode',button.dataset.aiGenerate);try{const json=await post('{{ ai_generate }}',data);if(json.error)throw new Error(json.error);const result=json.result||{};if(result.description)document.querySelector('#ai-description').value=result.description;if(result.meta_title)document.querySelector('#ai-meta-title').value=result.meta_title;if(result.meta_description)document.querySelector('#ai-meta-description').value=result.meta_description;if(result.meta_keyword)document.querySelector('#ai-meta-keyword').value=result.meta_keyword;status.textContent='Draft ready. Review it before applying.';}catch(error){status.textContent=error.message;}finally{button.disabled=false;}}));
  document.querySelector('#ai-apply').addEventListener('click',async()=>{const data=new FormData();['product_id','language_id'].forEach(key=>data.set(key,document.querySelector('#ai-'+key.replace('_','-')).value));data.set('description',document.querySelector('#ai-description').value);data.set('meta_title',document.querySelector('#ai-meta-title').value);data.set('meta_description',document.querySelector('#ai-meta-description').value);data.set('meta_keyword',document.querySelector('#ai-meta-keyword').value);status.textContent='Applying…';try{const json=await post('{{ ai_apply }}',data);status.textContent=json.success||json.error;}catch{status.textContent='Request failed.';}});

  document.querySelectorAll('[data-bs-toggle="tab"]').forEach(tab=>tab.addEventListener('shown.bs.tab',()=>history.replaceState(null,'',tab.dataset.bsTarget)));
  if(location.hash){const tab=[...document.querySelectorAll('[data-bs-toggle="tab"]')].find(item=>item.dataset.bsTarget===location.hash);if(tab&&window.bootstrap)bootstrap.Tab.getOrCreateInstance(tab).show();}

  const catalogInput=document.querySelector('#input-catalog-file');
  const catalogDrop=document.querySelector('#catalog-drop');
  const catalogLabel=document.querySelector('#catalog-file-label');
  const catalogPreview=document.querySelector('#catalog-preview');
  const catalogButton=document.querySelector('#button-catalog-import');
  const parsePreview=(text,limit=5)=>{const first=(text.split(/\r?\n/,1)[0]||'');const options=[',',';','\t'];const delimiter=options.sort((a,b)=>first.split(b).length-first.split(a).length)[0];const rows=[];let row=[],cell='',quoted=false;for(let i=0;i<text.length&&rows.length<limit+1;i++){const char=text[i];if(char==='"'){if(quoted&&text[i+1]==='"'){cell+='"';i++;}else quoted=!quoted;}else if(char===delimiter&&!quoted){row.push(cell);cell='';}else if((char==='\n'||char==='\r')&&!quoted){if(char==='\r'&&text[i+1]==='\n')i++;row.push(cell);if(row.some(value=>value.trim()))rows.push(row);row=[];cell='';}else cell+=char;}if((cell||row.length)&&rows.length<limit+1){row.push(cell);rows.push(row);}return rows;};
  const drawCatalogPreview=async file=>{
    catalogLabel.textContent='{{ text_catalog_selected|escape('js') }}'.replace('%s',file.name);
    catalogButton.disabled=!file.name.toLowerCase().endsWith('.csv');
    const rows=parsePreview(await file.slice(0,200000).text());
    catalogPreview.replaceChildren();
    if(rows.length<2){const message=document.createElement('p');message.className='text-danger text-center p-3 mb-0';message.textContent='{{ error_catalog_empty|escape('js') }}';catalogPreview.append(message);return;}
    const headers=rows[0].map(value=>value.replace(/^\uFEFF/,'').trim().toLowerCase());
    const keys=['model','name','language_code','price'];
    const table=document.createElement('table');table.className='table table-sm table-hover';
    const head=document.createElement('thead');const headRow=document.createElement('tr');keys.forEach(key=>{const th=document.createElement('th');th.textContent=key;headRow.append(th);});head.append(headRow);table.append(head);
    const body=document.createElement('tbody');rows.slice(1).forEach(values=>{const tr=document.createElement('tr');keys.forEach(key=>{const td=document.createElement('td');const index=headers.indexOf(key);td.textContent=index>=0?(values[index]||''):'—';tr.append(td);});body.append(tr);});table.append(body);catalogPreview.append(table);
  };
  catalogInput.addEventListener('change',()=>{if(catalogInput.files[0])drawCatalogPreview(catalogInput.files[0]);});
  ['dragenter','dragover'].forEach(type=>catalogDrop.addEventListener(type,event=>{event.preventDefault();catalogDrop.classList.add('is-dragging');}));
  ['dragleave','drop'].forEach(type=>catalogDrop.addEventListener(type,event=>{event.preventDefault();catalogDrop.classList.remove('is-dragging');}));
  catalogDrop.addEventListener('drop',event=>{const file=event.dataTransfer.files[0];if(!file)return;const transfer=new DataTransfer();transfer.items.add(file);catalogInput.files=transfer.files;drawCatalogPreview(file);});
  document.querySelector('#form-catalog-import').addEventListener('submit',()=>{catalogButton.disabled=true;catalogButton.innerHTML='<span class="spinner-border spinner-border-sm" aria-hidden="true"></span> Importing…';});

  // Supplier feed: upload once, then drive the queue in small batches so no
  // single request has to download hundreds of images.
  const feedInput=document.querySelector('#input-feed-file');
  const feedLabel=document.querySelector('#feed-file-label');
  const feedImport=document.querySelector('#button-feed-import');
  const feedStop=document.querySelector('#button-feed-cancel');
  const feedResume=document.querySelector('#button-feed-resume');
  const feedBar=document.querySelector('#feed-progress-bar');
  const feedText=document.querySelector('#feed-progress-text');
  const feedFailures=document.querySelector('#feed-failures');
  const feedFailureList=document.querySelector('#feed-failure-list');
  const feedIdleText=feedText.textContent;
  const progressTemplate='{{ text_feed_progress|escape('js') }}';
  const doneTemplate='{{ text_feed_done|escape('js') }}';
  const stat=(id,value)=>{document.querySelector('#feed-stat-'+id).textContent=Number(value||0).toLocaleString();};
  let feedRunId=0,feedActive=false;

  const format=(template,...values)=>{let index=0;return template.replace(/%s|%d/g,()=>Number(values[index]!==undefined?values[index++]:0).toLocaleString());};

  const renderRun=run=>{
    if(!run||!run.run_id){feedText.textContent=feedIdleText;return;}
    feedRunId=Number(run.run_id);
    const total=Number(run.total||0),processed=Number(run.processed||0);
    const percent=total?Math.round(processed/total*100):0;
    feedBar.style.width=percent+'%';feedBar.textContent=percent+'%';
    ['created','updated','failed','images','retired'].forEach(key=>stat(key,run[key]));
    feedText.textContent=run.status==='done'
      ? format(doneTemplate,run.created,run.updated,run.failed,run.images,run.retired)
      : format(progressTemplate,processed,total);
    feedBar.classList.toggle('progress-bar-animated',run.status==='running');
    feedBar.classList.toggle('bg-danger',Number(run.failed||0)>0);
    feedStop.classList.toggle('d-none',run.status!=='running'||!feedActive);
    feedResume.classList.toggle('d-none',run.status!=='running'||feedActive);
    if(Number(run.failed||0)>0)loadFailures();
  };

  const loadFailures=async()=>{
    try{
      const response=await fetch('{{ feed_failures }}&run_id='+feedRunId,{headers:{'X-Requested-With':'XMLHttpRequest'}});
      const json=await response.json();
      if(!json.failures||!json.failures.length)return;
      feedFailureList.replaceChildren(...json.failures.map(item=>{const li=document.createElement('li');li.textContent=item.articul+' — '+item.message;return li;}));
      feedFailures.classList.remove('d-none');
    }catch{/* the report is informational only */}
  };

  const runQueue=async()=>{
    feedActive=true;feedImport.disabled=true;
    while(feedActive){
      const data=new FormData();data.set('run_id',feedRunId);data.set('limit','5');
      let json;
      try{json=await post('{{ feed_process }}',data);}
      catch{feedText.textContent='Connection lost. Press Resume to continue.';break;}
      if(json.error){feedText.textContent=json.error;break;}
      renderRun(json);
      if(json.status!=='running'||Number(json.remaining||0)===0)break;
    }
    feedActive=false;feedImport.disabled=!feedInput.files.length;
    feedStop.classList.add('d-none');
  };

  feedInput.addEventListener('change',()=>{
    const file=feedInput.files[0];
    if(!file)return;
    feedLabel.textContent=file.name;
    feedImport.disabled=!file.name.toLowerCase().endsWith('.csv');
  });

  feedImport.addEventListener('click',async()=>{
    const file=feedInput.files[0];
    if(!file)return;
    feedImport.disabled=true;
    feedText.textContent='Uploading…';
    const data=new FormData();data.set('feed_file',file);
    try{
      const json=await post('{{ feed_upload }}',data);
      if(json.error){feedText.textContent=json.error;feedImport.disabled=false;return;}
      feedRunId=Number(json.run_id);
      feedFailures.classList.add('d-none');
      feedText.textContent=json.success;
      await runQueue();
    }catch{feedText.textContent='The feed could not be uploaded.';feedImport.disabled=false;}
  });

  feedStop.addEventListener('click',async()=>{
    feedActive=false;
    const data=new FormData();data.set('run_id',feedRunId);
    try{await post('{{ feed_cancel }}',data);}catch{/* the run stops client-side regardless */}
  });

  feedResume.addEventListener('click',()=>{if(feedRunId)runQueue();});

  {% if feed_run.run_id is defined %}renderRun({{ feed_run|json_encode|raw }});{% endif %}
})();
</script>
{{ footer }}
