{{ header }}
<main class="six-listing-page">
  <section class="listing-hero">
    <div class="listing-hero__index" aria-hidden="true">
      <span>6M</span>
      <i></i>
      <span>01—06</span>
    </div>
    <div class="listing-hero__copy">
      <p class="eyebrow">{{ six_collections }}</p>
      <h1>{{ heading_title|trim('.') }}</h1>
      <div class="listing-description">
        {% if description %}{{ description }}{% else %}<p>{{ six_catalog_intro }}</p>{% endif %}
      </div>
    </div>
    <p class="listing-hero__note">{{ six_collections_copy }}</p>
  </section>

  <div id="product-listing" class="listing-content">
    {{ content_top }}

    {% if six_listing_categories %}
      <section class="listing-categories" aria-labelledby="listing-categories-title">
        <header class="listing-section-heading">
          <div>
            <h2 id="listing-categories-title">{{ six_shop_by_type|trim('.') }}</h2>
            <span>{{ six_listing_categories|length < 10 ? '0' : '' }}{{ six_listing_categories|length }}</span>
          </div>
          <a class="listing-category-all" href="{{ six_catalog_url }}">
            <span>00</span>
            <strong>{{ six_all }}</strong>
            <i aria-hidden="true">↗</i>
          </a>
        </header>
        <nav class="listing-category-grid" aria-label="{{ six_shop_by_type }}">
          {% for category in six_listing_categories %}
            <a class="listing-category-link" href="{{ category.href }}">
              {% if category.image %}<img src="{{ category.image }}" width="900" height="720" loading="lazy" alt="">{% endif %}
              <span class="listing-category-link__number">{{ loop.index < 10 ? '0' : '' }}{{ loop.index }}</span>
              <strong>{{ category.name }}</strong>
              <i aria-hidden="true">↗</i>
            </a>
          {% endfor %}
        </nav>
      </section>
    {% endif %}

    <div class="listing-shell">
    {{ six_filter_panel }}
    <section class="listing-results" aria-labelledby="listing-results-title">
      <div class="listing-toolbar">
        <div class="listing-count" id="listing-results-title">
          <strong>{{ products|length }}</strong>
          <span>{{ six_pieces }}</span>
        </div>
        <div class="listing-controls">
          <button class="filter-toggle" type="button" data-six-filter-toggle>{{ six_filters }}</button>
          <label>
            <span>{{ six_sort }}</span>
            <select aria-label="{{ six_sort }}" onchange="location=this.value">
              {% for item in sorts %}<option value="{{ item.href }}"{% if item.value == sort ~ '-' ~ order %} selected{% endif %}>{{ item.text }}</option>{% endfor %}
            </select>
          </label>
          <label>
            <span>{{ entry_show }}</span>
            <select aria-label="{{ entry_show }}" onchange="location=this.value">
              {% for item in limits %}<option value="{{ item.href }}"{% if item.value == limit %} selected{% endif %}>{{ item.text }}</option>{% endfor %}
            </select>
          </label>
        </div>
      </div>

      {% if products %}
        <div class="collection-grid product-grid listing-product-grid">{% for product in products %}{{ product }}{% endfor %}</div>
        <div class="pagination-shell">{{ pagination }}<p>{{ results }}</p></div>
      {% else %}
        <div class="listing-empty-state">
          <div class="listing-empty-state__mark" aria-hidden="true"><span>6</span><i></i></div>
          <div class="listing-empty-state__copy">
            <p class="eyebrow">{{ six_collections }}</p>
            <h2>{{ six_no_products|trim('.') }}</h2>
            <p>{{ six_catalog_intro }}</p>
            <a class="button button--dark" href="{{ six_catalog_url }}">{{ six_view_all }}</a>
          </div>
          <span class="listing-empty-state__number" aria-hidden="true">00</span>
        </div>
      {% endif %}
    </section>
    </div>

    {{ content_bottom }}
  </div>
</main>
{{ footer }}
