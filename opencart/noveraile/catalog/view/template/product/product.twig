{{ header }}
<div id="product-info" class="six-product-page">
  <nav class="breadcrumbs">{% for breadcrumb in breadcrumbs %}{% if loop.last %}<span class="breadcrumbs__current" aria-current="page">{{ breadcrumb.text }}</span>{% else %}<a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a><span aria-hidden="true">/</span>{% endif %}{% endfor %}</nav>
  {{ content_top }}
  <section class="product-detail">
    <div class="product-gallery" data-six-product-gallery>
      {% if thumb %}
        <a class="product-visual" href="{{ popup }}" data-six-zoom-open aria-controls="six-product-zoom" aria-haspopup="dialog">
          <img class="product-photo product-photo--detail" src="{{ thumb }}" fetchpriority="high" loading="eager" decoding="async" alt="{{ heading_title }}">
          <span class="product-zoom-hint"><span aria-hidden="true">＋</span> {{ six_zoom }}</span>
        </a>
        <div id="six-product-zoom" class="product-zoom-dialog" data-six-zoom aria-hidden="true" role="dialog" aria-modal="true" aria-label="{{ heading_title }} — zoom">
          <button class="product-zoom-close" type="button" data-six-zoom-close aria-label="{{ six_close_zoom }}"><span aria-hidden="true">×</span></button>
          <div class="product-zoom-stage" data-six-zoom-stage>
            <img class="product-zoom-image" data-six-zoom-image src="{{ popup }}" loading="lazy" decoding="async" alt="{{ heading_title }}" draggable="false">
          </div>
          <div class="product-zoom-toolbar" aria-label="{{ six_zoom_controls }}">
            <button type="button" data-six-zoom-out aria-label="{{ six_zoom_out }}">−</button>
            <output data-six-zoom-level aria-live="polite">100%</output>
            <button type="button" data-six-zoom-in aria-label="{{ six_zoom_in }}">＋</button>
            <button class="product-zoom-reset" type="button" data-six-zoom-reset>Fit</button>
          </div>
          <p class="product-zoom-help">Scroll or use ＋/− to zoom · drag to move · Esc to close</p>
        </div>
      {% endif %}
      {% for video in six_videos %}
        <figure class="product-video" data-six-video="{{ loop.index0 }}" hidden>
          <div class="product-video__frame">
            {% if video.kind == 'embed' %}
              <iframe src="{{ video.src }}" title="{{ heading_title }} — {{ six_video }}" loading="lazy" referrerpolicy="strict-origin-when-cross-origin" allow="accelerometer; autoplay; encrypted-media; gyroscope; picture-in-picture; fullscreen" allowfullscreen></iframe>
            {% else %}
              <video data-six-video-player controls playsinline preload="metadata"{% if video.poster %} poster="{{ video.poster }}"{% endif %}><source src="{{ video.src }}" type="{{ video.type }}"></video>
            {% endif %}
          </div>
          <figcaption><span aria-hidden="true">▶</span>{{ six_video }}</figcaption>
        </figure>
      {% endfor %}
      {% if thumb and (images or six_videos) %}
        <div class="product-thumbnails">
          <a href="{{ popup }}" data-six-zoom-source aria-current="true" aria-label="{{ heading_title }}"><img src="{{ thumb }}" loading="lazy" decoding="async" alt="{{ heading_title }}"></a>
          {% for image in images %}<a href="{{ image.popup }}" data-six-zoom-source aria-label="{{ heading_title }}"><img src="{{ image.thumb }}" loading="lazy" decoding="async" alt="{{ heading_title }}"></a>{% endfor %}
          {% for video in six_videos %}
            <button class="product-thumbnails__video" type="button" data-six-video-source="{{ loop.index0 }}" aria-label="{{ six_play_video }}">
              {% if video.poster %}<img src="{{ video.poster }}" loading="lazy" decoding="async" alt="">{% endif %}
              <span aria-hidden="true">▶</span>
            </button>
          {% endfor %}
        </div>
      {% endif %}
    </div>
    <div class="product-copy">
      <p class="eyebrow">{{ six_moment }}</p><h1>{{ heading_title|trim('.') }}</h1>
      <p class="product-price">{% if special %}<del>{{ price }}</del> {{ special }}{% else %}{{ price }}{% endif %}</p>
      <div class="product-status-line"><span>{{ six_product_code }}: <strong>{{ model }}</strong></span><span>{{ six_stock }}: <strong>{{ stock }}</strong></span><span>{{ six_weight }}: <strong>{{ six_product_weight }}</strong></span></div>
      {% if six_metal_options %}<div class="product-metal-list" aria-label="{{ six_metal }}">{% for metal in six_metal_options %}<span><i class="metal-swatch metal-swatch--{{ metal.key }}" aria-hidden="true"></i>{{ metal.name }}</span>{% endfor %}</div>{% endif %}
      <dl class="product-key-specs">{% if six_fineness_value and six_fineness_value != '—' %}<div><dt>{{ six_fineness }}</dt><dd>{{ six_fineness_value }}</dd></div>{% endif %}<div><dt>{{ six_stone }}</dt><dd>{{ six_stone_value }}</dd></div>{% if six_carat_value and six_carat_value != '—' %}<div><dt>{{ six_carat }}</dt><dd>{{ six_carat_value }}</dd></div>{% endif %}{% if six_stones_value and six_stones_value != '—' %}<div><dt>{{ six_stone_count }}</dt><dd>{{ six_stones_value }}</dd></div>{% endif %}{% if six_collections_value %}<div><dt>{{ six_collections }}</dt><dd>{{ six_collections_value }}</dd></div>{% endif %}<div><dt>{{ six_delivery }}</dt><dd>{{ six_delivery_value }}</dd></div></dl>
      <div class="product-description">{{ description|raw }}</div>
      <div class="product-purchase">
        <form id="form-product" class="six-product-form">
          <div class="product-options">
            {% for option in options %}
              <fieldset class="option-group option-group--{{ option.type }}{% if option.required %} required{% endif %}"><legend><span>{{ option.name }}</span>{% if option.required %}<i aria-hidden="true">＊</i>{% endif %}</legend>
              {% if option.type == 'select' %}<div class="select-wrap"><select name="option[{{ option.product_option_id }}]" id="input-option-{{ option.product_option_id }}"{% if option.required %} required aria-required="true"{% endif %}><option value="">{{ text_select }}</option>{% for option_value in option.product_option_value %}<option value="{{ option_value.product_option_value_id }}">{{ option_value.name }}{% if option_value.price %} ({{ option_value.price_prefix }}{{ option_value.price }}){% endif %}</option>{% endfor %}</select></div>{% endif %}
              {% if option.type == 'radio' %}<div class="option-values">{% for option_value in option.product_option_value %}<label><input type="radio" name="option[{{ option.product_option_id }}]" value="{{ option_value.product_option_value_id }}"><span>{{ option_value.name }}</span></label>{% endfor %}</div>{% endif %}
              {% if option.type == 'checkbox' %}<div class="option-values">{% for option_value in option.product_option_value %}<label><input type="checkbox" name="option[{{ option.product_option_id }}][]" value="{{ option_value.product_option_value_id }}"><span>{{ option_value.name }}</span></label>{% endfor %}</div>{% endif %}
              {% if option.type == 'text' %}<input type="text" name="option[{{ option.product_option_id }}]" value="{{ option.value }}" id="input-option-{{ option.product_option_id }}" maxlength="80" placeholder="{{ option.name }}">{% endif %}
              {% if option.type == 'textarea' %}<textarea name="option[{{ option.product_option_id }}]" id="input-option-{{ option.product_option_id }}" rows="3" placeholder="{{ option.name }}">{{ option.value }}</textarea>{% endif %}
              {% if option.type == 'date' %}<input type="date" name="option[{{ option.product_option_id }}]" value="{{ option.value }}" id="input-option-{{ option.product_option_id }}">{% endif %}
              <div id="error-option-{{ option.product_option_id }}" class="invalid-feedback"></div></fieldset>
            {% endfor %}
          </div>
          <details class="size-guide"><summary><span>{{ six_size_title }}</span></summary><div class="size-guide__content"><p>{{ six_size_copy }}</p><div class="size-table"><span>EU</span><span>US</span><span>Ø mm</span><b>50</b><b>5¼</b><b>15.9</b><b>52</b><b>6</b><b>16.5</b><b>54</b><b>7</b><b>17.2</b><b>56</b><b>7½</b><b>17.8</b><b>58</b><b>8½</b><b>18.5</b><b>60</b><b>9</b><b>19.1</b></div></div></details>
          <div class="quantity-row"><label class="quantity-control" for="input-quantity"><span>{{ entry_qty }}</span><input id="input-quantity" name="quantity" type="number" min="{{ minimum }}" value="{{ minimum }}" inputmode="numeric"></label><button id="button-cart" class="button button--dark add-button" type="submit"><span>{{ six_add_to_bag }}</span><span class="add-button__arrow" aria-hidden="true">→</span></button></div>
          <input type="hidden" name="product_id" value="{{ product_id }}" id="input-product-id">
          <div id="error-quantity" class="invalid-feedback"></div>
        </form>
        <form method="post" data-oc-toggle="ajax" class="product-secondary-actions"><button type="submit" formaction="{{ wishlist_add }}"><svg class="wishlist-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M20.8 4.7a5.5 5.5 0 0 0-7.8 0L12 5.8l-1.1-1.1a5.5 5.5 0 0 0-7.8 7.8l1.1 1.1L12 21.3l7.8-7.7 1.1-1.1a5.5 5.5 0 0 0-.1-7.8Z"/></svg><span>{{ six_wishlist }}</span></button><input type="hidden" name="product_id" value="{{ product_id }}"></form>
      </div>
      <ul class="product-service-links">
        <li><span class="product-service-icon product-service-icon--stock" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="m6.5 12.5 3.4 3.4L17.8 8"/></svg></span><span><small>{{ six_stock }}</small><strong>{{ stock }}</strong></span></li>
        <li><a href="{{ six_shipping_url }}"><span class="product-service-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M3 6h11v10H3zM14 9h4l3 3v4h-7z"/><circle cx="7" cy="18" r="2"/><circle cx="18" cy="18" r="2"/></svg></span><span><small>{{ six_delivery }}</small><strong>{{ six_delivery_value }}</strong></span><span class="product-service-arrow" aria-hidden="true">↗</span></a></li>
        <li><span class="product-service-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M4 9h16v11H4zM3 6h18v3H3zM12 6v14M12 6c-1.5-3.2-5.7-3.2-5.7-.5C6.3 7.2 8.3 8 12 8M12 6c1.5-3.2 5.7-3.2 5.7-.5 0 1.7-2 2.5-5.7 2.5"/></svg></span><span><strong>{{ six_packaging }}</strong></span></li>
      </ul>
      <details class="product-accordion"><summary>{{ six_description }}</summary><div>{{ description|raw }}</div></details>
      {% if attribute_groups %}<details class="product-accordion"><summary>{{ six_details }}</summary><dl class="specification-block">{% for group in attribute_groups %}{% for attribute in group.attribute %}<div><dt>{{ attribute.name }}</dt><dd>{{ attribute.text }}</dd></div>{% endfor %}{% endfor %}</dl></details>{% endif %}
    </div>
  </section>
  {% if six_bundle_product %}<section class="bundle-offer"><div><p class="eyebrow">{{ six_bundle }}</p><h2>{{ six_bundle_title|trim('.') }}</h2><p>{{ six_bundle_copy }}</p><p class="bundle-price"><del>{{ price }} + {{ six_bundle_product.price }}</del><strong>{{ six_bundle_product.set_price }}</strong></p><button class="button button--dark" type="button" data-six-bundle-add data-product-id="{{ product_id }}" data-paired-id="{{ six_bundle_product.product_id }}" data-cart-action="{{ six_cart_add }}" data-bundle-action="{{ six_bundle_add }}">{{ six_add_set }}</button><p class="six-form-status" role="status"></p></div><a href="{{ six_bundle_product.href }}"><img src="{{ six_bundle_product.image }}" width="520" height="520" loading="lazy" decoding="async" alt="{{ six_bundle_product.name }}"><span>{{ six_bundle_product.name }}</span></a></section>{% endif %}
  {% if related %}<section class="recommendations"><div class="editorial-heading"><p class="editorial-script">{{ six_may_like }}</p><h2>{{ six_may_like|trim('.') }}</h2></div>{{ related }}</section>{% endif %}
  {% if review_status %}<section class="product-reviews">{{ review }}</section>{% endif %}
  <section class="gift-hint-section"><div><p class="eyebrow">{{ six_hint_title }}</p><h2>{{ six_hint_title|trim('.') }}</h2><p>{{ six_hint_copy }}</p></div><form class="hint-form" action="{{ six_hint_action }}" method="post" data-six-ajax-form><input type="hidden" name="product_id" value="{{ product_id }}"><label>{{ six_sender_name }}<input name="sender_name" required></label><label>{{ six_sender_email }}<input type="email" name="sender_email" required></label><label>{{ six_recipient_name }}<input name="recipient_name" required></label><label>{{ six_recipient_email }}<input type="email" name="recipient_email" required></label><label class="hint-message">{{ six_message }}<textarea name="message" rows="3"></textarea></label><button class="button button--dark" type="submit">{{ six_send_hint }}</button><p class="six-form-status" role="status"></p></form></section>
  {{ content_bottom }}
</div>
<script>
$('#form-product').on('submit', function(e) {
  e.preventDefault();
  $.ajax({url:'index.php?route=checkout/cart.add&language={{ language }}',type:'post',data:$('#form-product').serialize(),dataType:'json',beforeSend:function(){$('#button-cart').prop('disabled',true);},complete:function(){$('#button-cart').prop('disabled',false);},success:function(json){
    $('#form-product .is-invalid').removeClass('is-invalid'); $('#form-product .invalid-feedback').removeClass('d-block');
    if(json.error){for(const key in json.error){$('#input-'+key.replaceAll('_','-')).addClass('is-invalid');$('#error-'+key.replaceAll('_','-')).html(json.error[key]).addClass('d-block');}}
    if(json.success){
      $('#alert').prepend('<div class="alert alert-success alert-dismissible">'+json.success+'<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>');
      const addedQuantity = Math.max(1, Number($('#input-quantity').val()) || 1);
      document.querySelectorAll('.bag span').forEach(function(badge){ badge.textContent = (Number(badge.textContent) || 0) + addedQuantity; });
    }
  }});
});
</script>
{{ footer }}
