<article class="moment-card product-card"{% if six_filter_tags is defined %} data-tags="{{ six_filter_tags|e('html_attr') }}" data-price="{{ six_filter_price }}"{% endif %}>
  <a href="{{ href }}"><div class="moment-art"><img class="product-photo" src="{{ thumb }}" width="900" height="900" loading="lazy" decoding="async" alt="{{ name }}"><span class="moment-number">{{ six_moment }}</span><span class="card-arrow">↗</span></div><p class="product-kicker">{{ six_moment|trim('.') }}</p><div class="product-line"><h3>{{ name|trim('.') }}</h3><span class="card-price">{% if special %}<del>{{ price }}</del>{{ special }}{% else %}{{ price }}{% endif %}</span></div>{% if six_metal_options %}<div class="card-metal-line"><span class="card-metal-label">{{ six_metal }}</span><ul aria-label="{{ six_metal }}">{% for metal in six_metal_options %}<li><span class="metal-swatch metal-swatch--{{ metal.key }}" aria-hidden="true"></span>{{ metal.name }}{% if six_fineness_value %}<small>{{ six_fineness_value }}</small>{% endif %}</li>{% endfor %}</ul></div>{% endif %}<p>{{ description }}</p><dl class="card-specs"><div><dt>{{ six_product_code }}</dt><dd>{{ six_sku }}</dd></div><div><dt>{{ six_weight }}</dt><dd>{{ six_product_weight }}</dd></div><div><dt>{{ six_carat }}</dt><dd>{{ six_product_carat }}</dd></div><div><dt>{{ six_stone_count }}</dt><dd>{{ six_product_stones }}</dd></div></dl></a>
  <form class="card-footer" method="post" data-oc-toggle="ajax"><span class="stock-status{% if six_stocked %} is-stocked{% endif %}">{% if six_stocked %}{{ six_in_stock }}{% else %}{{ six_preorder }}{% endif %}</span><button type="submit" formaction="{{ cart_add }}">{{ six_add_to_bag }}</button><input type="hidden" name="product_id" value="{{ product_id }}"><input type="hidden" name="quantity" value="{{ minimum }}"></form>
</article>
