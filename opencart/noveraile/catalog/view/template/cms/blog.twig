{{ header }}
<section class="interior-hero interior-hero--journal">
  <div>
    <p class="eyebrow">{{ six_journal_kicker }}</p>
    <h1>{{ six_journal_title|trim('.') }}</h1>
    <p>{{ six_journal_copy }}</p>
  </div>
  <span class="interior-mark" aria-hidden="true">J</span>
</section>

<section class="journal-page" aria-label="{{ heading_title }}">
  {% if image or description %}
    <div class="journal-topic">
      {% if image %}<img src="{{ image }}" alt="{{ heading_title }}">{% endif %}
      {% if description %}<div>{{ description }}</div>{% endif %}
    </div>
  {% endif %}

  <form class="journal-toolbar" action="index.php" method="get">
    <input type="hidden" name="route" value="cms/blog">
    <input type="hidden" name="language" value="{{ language }}">
    <label class="journal-search" for="input-search">
      <span>{{ entry_search }}</span>
      <input type="search" name="search" value="{{ search }}" placeholder="{{ six_journal_search }}" id="input-search">
    </label>
    {% if topics %}
      <label for="input-topic">
        <span>{{ text_all }}</span>
        <select name="topic_id" id="input-topic">
          <option value="">{{ text_all }}</option>
          {% for topic in topics %}
            <option value="{{ topic.topic_id }}"{% if topic.topic_id == topic_id %} selected{% endif %}>{{ topic.name }}</option>
          {% endfor %}
        </select>
      </label>
    {% endif %}
    <label for="input-sort">
      <span>{{ text_sort }}</span>
      <select id="input-sort" onchange="location = this.value;">
        {% for sort_item in sorts %}
          <option value="{{ sort_item.href }}"{% if sort_item.value == '%s-%s'|format(sort, order) %} selected{% endif %}>{{ sort_item.text }}</option>
        {% endfor %}
      </select>
    </label>
    <button class="journal-search-button" type="submit">{{ button_search }} <span aria-hidden="true">→</span></button>
  </form>

  {% if articles %}
    <div class="journal-grid">
      {% for article in articles %}
        <article>
          <a class="journal-card" href="{{ article.href }}">
            <span class="journal-art-wrap">
              <img class="journal-art" src="{{ article.image }}" alt="{{ article.name }}">
              <span class="journal-art-arrow" aria-hidden="true">↗</span>
            </span>
            <span class="eyebrow">{{ article.six_label }} · {{ article.date_added }}</span>
            <h2>{{ article.name|trim('.') }}</h2>
            <span class="journal-excerpt">{{ article.description }}</span>
            <span class="journal-card-link">{{ six_read_note }} <span aria-hidden="true">↗</span></span>
          </a>
        </article>
      {% endfor %}
    </div>
    <div class="journal-pagination">
      <div>{{ pagination }}</div>
      <p>{{ results }}</p>
    </div>
  {% else %}
    <div class="journal-empty">
      <p class="eyebrow">{{ six_journal_kicker }}</p>
      <h2>{{ text_no_results|trim('.') }}</h2>
      <a class="text-link" href="index.php?route=cms/blog&amp;language={{ language }}">{{ six_clear }} <span aria-hidden="true">→</span></a>
    </div>
  {% endif %}

  {{ content_top }}
  {{ content_bottom }}
</section>
{{ footer }}
