{{ header }}
<section class="quiz-shell" data-six-quiz data-rules="{{ quiz_rules }}" data-finish="{{ six_show_results }}">
  <header class="quiz-heading">
    <div class="quiz-heading__meta"><p class="eyebrow">NOVERAILE · PERSONAL EDIT</p><span><b data-quiz-current>01</b> / 05</span></div>
    <h1>{{ six_quiz_title }}</h1>
    <p>{{ six_quiz_intro }}</p>
    <div class="quiz-progress" aria-label="Quiz progress"><span></span><i></i><i></i><i></i><i></i><i></i></div>
  </header>
  <form class="quiz-form">
    <fieldset data-step="1"><legend><small>01 · YOUR MOMENT</small>{{ six_quiz_occasion }}</legend><div class="quiz-options"><label><input type="radio" name="occasion" value="engagement" required><span><b>01</b><em>{{ six_moment_yes }}</em><i>✓</i></span></label><label><input type="radio" name="occasion" value="wedding"><span><b>02</b><em>{{ six_moment_forever }}</em><i>✓</i></span></label><label><input type="radio" name="occasion" value="motherhood"><span><b>03</b><em>{{ six_moment_new_life }}</em><i>✓</i></span></label><label><input type="radio" name="occasion" value="career"><span><b>04</b><em>{{ six_moment_victory }}</em><i>✓</i></span></label><label><input type="radio" name="occasion" value="self-purchase"><span><b>05</b><em>{{ six_moment_deserve }}</em><i>✓</i></span></label><label><input type="radio" name="occasion" value="milestone"><span><b>06</b><em>{{ six_moment_with_me }}</em><i>✓</i></span></label></div></fieldset>
    <fieldset data-step="2" hidden><legend><small>02 · YOUR RANGE</small>{{ six_quiz_budget }}</legend><div class="quiz-options quiz-options--three"><label><input type="radio" name="budget" value="1200"><span><b>01</b><em>≤ 1,200</em><i>✓</i></span></label><label><input type="radio" name="budget" value="2000"><span><b>02</b><em>1,200–2,000</em><i>✓</i></span></label><label><input type="radio" name="budget" value="999999"><span><b>03</b><em>2,000+</em><i>✓</i></span></label></div></fieldset>
    <fieldset data-step="3" hidden><legend><small>03 · THE PIECE</small>{{ six_quiz_type }}</legend><div class="quiz-options quiz-options--four"><label><input type="radio" name="type" value="ring"><span><b>01</b><em>Rings</em><i>✓</i></span></label><label><input type="radio" name="type" value="earring"><span><b>02</b><em>Earrings</em><i>✓</i></span></label><label><input type="radio" name="type" value="necklace"><span><b>03</b><em>Necklaces</em><i>✓</i></span></label><label><input type="radio" name="type" value="bracelet"><span><b>04</b><em>Bracelets</em><i>✓</i></span></label></div></fieldset>
    <fieldset data-step="4" hidden><legend><small>04 · THE METAL</small>{{ six_quiz_metal }}</legend><div class="quiz-options quiz-options--four"><label><input type="radio" name="metal" value="white-gold"><span><b>01</b><em>{{ six_white_gold }}</em><i>✓</i></span></label><label><input type="radio" name="metal" value="yellow-gold"><span><b>02</b><em>{{ six_yellow_gold }}</em><i>✓</i></span></label><label><input type="radio" name="metal" value="rose-gold"><span><b>03</b><em>{{ six_rose_gold }}</em><i>✓</i></span></label><label><input type="radio" name="metal" value=""><span><b>04</b><em>{{ six_either }}</em><i>✓</i></span></label></div></fieldset>
    <fieldset data-step="5" hidden><legend><small>05 · THE STONE</small>{{ six_quiz_stone }}</legend><div class="quiz-options quiz-options--three"><label><input type="radio" name="stone" value="lab-grown"><span><b>01</b><em>{{ six_lab_grown }}</em><i>✓</i></span></label><label><input type="radio" name="stone" value="natural"><span><b>02</b><em>{{ six_natural }}</em><i>✓</i></span></label><label><input type="radio" name="stone" value=""><span><b>03</b><em>{{ six_either }}</em><i>✓</i></span></label></div></fieldset>
    <p class="quiz-error" role="alert" data-quiz-error>Please select one answer to continue.</p>
    <div class="quiz-actions"><button class="quiz-back" type="button" data-quiz-back hidden><span>←</span> {{ six_back }}</button><button class="quiz-next" type="button" data-quiz-next><span>{{ six_start }}</span><b>→</b></button></div>
  </form>
  <section class="quiz-results" hidden><p class="eyebrow">{{ six_result }}</p><h2 data-quiz-moment></h2><p class="quiz-results__intro">A personal selection shaped around your answers.</p><div class="collection-grid product-grid quiz-product-grid">{% for product in products %}{{ product.card }}{% endfor %}</div><form class="quiz-email" action="{{ newsletter_action }}" method="post" data-six-ajax-form><h3>{{ six_email_edit }}</h3><p>{{ six_email_edit_copy }}</p><div><input type="email" name="email" placeholder="{{ six_newsletter_placeholder }}" required><button class="button button--dark" type="submit">{{ six_send_edit }}</button></div><label><input type="checkbox" name="consent" value="1" required> {{ six_consent }}</label><p class="six-form-status" role="status"></p></form></section>
</section>
{{ footer }}
