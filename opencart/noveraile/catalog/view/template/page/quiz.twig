{{ header }}
<section class="quiz-shell" data-six-quiz data-rules="{{ quiz_rules }}" data-start="{{ six_start }}" data-next="{{ six_next }}" data-finish="{{ six_show_results }}">
  <header class="quiz-heading">
    <div class="quiz-heading__meta"><p class="eyebrow">{{ six_brand_name|trim('.') }} · {{ six_personal_edit }}</p><span><b data-quiz-current>01</b> / 05</span></div>
    <h1>{{ six_quiz_title|trim('.') }}</h1>
    <p>{{ six_quiz_intro }}</p>
    <div class="quiz-progress" aria-label="{{ six_quiz_progress }}"><span></span><i></i><i></i><i></i><i></i><i></i></div>
  </header>
  <form class="quiz-form">
    <fieldset data-step="1"><legend><small>01 · {{ six_your_moment }}</small>{{ six_quiz_occasion }}</legend><div class="quiz-options"><label><input type="radio" name="occasion" value="engagement" required><span><b>01</b><em>{{ six_moment_yes }}</em><i>✓</i></span></label><label><input type="radio" name="occasion" value="wedding"><span><b>02</b><em>{{ six_moment_forever }}</em><i>✓</i></span></label><label><input type="radio" name="occasion" value="motherhood"><span><b>03</b><em>{{ six_moment_new_life }}</em><i>✓</i></span></label><label><input type="radio" name="occasion" value="career"><span><b>04</b><em>{{ six_moment_victory }}</em><i>✓</i></span></label><label><input type="radio" name="occasion" value="self-purchase"><span><b>05</b><em>{{ six_moment_deserve }}</em><i>✓</i></span></label><label><input type="radio" name="occasion" value="milestone"><span><b>06</b><em>{{ six_moment_with_me }}</em><i>✓</i></span></label></div></fieldset>
    <fieldset data-step="2" hidden><legend><small>02 · {{ six_your_range }}</small>{{ six_quiz_budget }}</legend><div class="quiz-options quiz-options--three"><label><input type="radio" name="budget" value="0:{{ quiz_budget_low }}"><span><b>01</b><em>≤ {{ quiz_budget_low_label }}</em><i>✓</i></span></label><label><input type="radio" name="budget" value="{{ quiz_budget_low }}:{{ quiz_budget_high }}"><span><b>02</b><em>{{ quiz_budget_low_label }}–{{ quiz_budget_high_label }}</em><i>✓</i></span></label><label><input type="radio" name="budget" value="{{ quiz_budget_high }}:999999999"><span><b>03</b><em>{{ quiz_budget_high_label }}+</em><i>✓</i></span></label></div></fieldset>
    <fieldset data-step="3" hidden><legend><small>03 · {{ six_the_piece }}</small>{{ six_quiz_type }}</legend><div class="quiz-options quiz-options--four"><label><input type="radio" name="type" value="ring"><span><b>01</b><em>{{ six_type_rings }}</em><i>✓</i></span></label><label><input type="radio" name="type" value="earring"><span><b>02</b><em>{{ six_type_earrings }}</em><i>✓</i></span></label><label><input type="radio" name="type" value="necklace"><span><b>03</b><em>{{ six_type_necklaces }}</em><i>✓</i></span></label><label><input type="radio" name="type" value="bracelet"><span><b>04</b><em>{{ six_type_bracelets }}</em><i>✓</i></span></label></div></fieldset>
    <fieldset data-step="4" hidden><legend><small>04 · {{ six_the_metal }}</small>{{ six_quiz_metal }}</legend><div class="quiz-options quiz-options--four"><label><input type="radio" name="metal" value="white-gold"><span><b>01</b><em>{{ six_white_gold }}</em><i>✓</i></span></label><label><input type="radio" name="metal" value="yellow-gold"><span><b>02</b><em>{{ six_yellow_gold }}</em><i>✓</i></span></label><label><input type="radio" name="metal" value="rose-gold"><span><b>03</b><em>{{ six_rose_gold }}</em><i>✓</i></span></label><label><input type="radio" name="metal" value=""><span><b>04</b><em>{{ six_either }}</em><i>✓</i></span></label></div></fieldset>
    <fieldset data-step="5" hidden><legend><small>05 · {{ six_the_stone }}</small>{{ six_quiz_stone }}</legend><div class="quiz-options quiz-options--three"><label><input type="radio" name="stone" value="lab-grown"><span><b>01</b><em>{{ six_lab_grown }}</em><i>✓</i></span></label><label><input type="radio" name="stone" value="natural"><span><b>02</b><em>{{ six_natural }}</em><i>✓</i></span></label><label><input type="radio" name="stone" value=""><span><b>03</b><em>{{ six_either }}</em><i>✓</i></span></label></div></fieldset>
    <p class="quiz-error" role="alert" data-quiz-error>{{ six_quiz_select_error }}</p>
    <div class="quiz-actions"><button class="quiz-back" type="button" data-quiz-back hidden><span>←</span> {{ six_back }}</button><button class="quiz-next" type="button" data-quiz-next><span>{{ six_start }}</span><b>→</b></button></div>
  </form>
  <section class="quiz-results" hidden><p class="eyebrow">{{ six_result|trim('.') }}</p><h2 data-quiz-moment></h2><p class="quiz-results__intro">{{ six_quiz_result_intro }}</p><div class="collection-grid product-grid quiz-product-grid">{% for product in products %}{{ product.card }}{% endfor %}</div><form class="quiz-email" action="{{ newsletter_action }}" method="post" data-six-ajax-form><h3>{{ six_email_edit|trim('.') }}</h3><p>{{ six_email_edit_copy }}</p><div><input type="email" name="email" placeholder="{{ six_newsletter_placeholder }}" required><button class="button button--dark" type="submit">{{ six_send_edit }}</button></div><label><input type="checkbox" name="consent" value="1" required> {{ six_consent }}</label><p class="six-form-status" role="status"></p></form></section>
</section>
{{ footer }}
