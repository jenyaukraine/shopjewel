{{ header }}
<section class="quiz-shell" data-six-quiz data-rules="{{ quiz_rules }}" data-finish="{{ six_show_results }}">
  <header class="quiz-heading"><p class="eyebrow">NOVERAILE</p><h1>{{ six_quiz_title }}</h1><p>{{ six_quiz_intro }}</p><div class="quiz-progress"><span></span></div></header>
  <form class="quiz-form">
    <fieldset data-step="1"><legend>{{ six_quiz_occasion }}</legend><div class="quiz-options"><label><input type="radio" name="occasion" value="engagement" required><span>{{ six_moment_yes }}</span></label><label><input type="radio" name="occasion" value="wedding"><span>{{ six_moment_forever }}</span></label><label><input type="radio" name="occasion" value="motherhood"><span>{{ six_moment_new_life }}</span></label><label><input type="radio" name="occasion" value="career"><span>{{ six_moment_victory }}</span></label><label><input type="radio" name="occasion" value="self-purchase"><span>{{ six_moment_deserve }}</span></label><label><input type="radio" name="occasion" value="milestone"><span>{{ six_moment_with_me }}</span></label></div></fieldset>
    <fieldset data-step="2" hidden><legend>{{ six_quiz_budget }}</legend><div class="quiz-options"><label><input type="radio" name="budget" value="1200"><span>≤ 1,200</span></label><label><input type="radio" name="budget" value="2000"><span>1,200–2,000</span></label><label><input type="radio" name="budget" value="999999"><span>2,000+</span></label></div></fieldset>
    <fieldset data-step="3" hidden><legend>{{ six_quiz_type }}</legend><div class="quiz-options"><label><input type="radio" name="type" value="ring"><span>Rings</span></label><label><input type="radio" name="type" value="earring"><span>Earrings</span></label><label><input type="radio" name="type" value="necklace"><span>Necklaces</span></label><label><input type="radio" name="type" value="bracelet"><span>Bracelets</span></label></div></fieldset>
    <fieldset data-step="4" hidden><legend>{{ six_quiz_metal }}</legend><div class="quiz-options"><label><input type="radio" name="metal" value="white-gold"><span>{{ six_white_gold }}</span></label><label><input type="radio" name="metal" value="yellow-gold"><span>{{ six_yellow_gold }}</span></label><label><input type="radio" name="metal" value="rose-gold"><span>{{ six_rose_gold }}</span></label><label><input type="radio" name="metal" value=""><span>{{ six_either }}</span></label></div></fieldset>
    <fieldset data-step="5" hidden><legend>{{ six_quiz_stone }}</legend><div class="quiz-options"><label><input type="radio" name="stone" value="lab-grown"><span>{{ six_lab_grown }}</span></label><label><input type="radio" name="stone" value="natural"><span>{{ six_natural }}</span></label><label><input type="radio" name="stone" value=""><span>{{ six_either }}</span></label></div></fieldset>
    <div class="quiz-actions"><button class="text-link" type="button" data-quiz-back hidden>← {{ six_back }}</button><button class="button button--dark" type="button" data-quiz-next>{{ six_start }}</button></div>
  </form>
  <section class="quiz-results" hidden><p class="eyebrow">{{ six_result }}</p><h2 data-quiz-moment></h2><div class="collection-grid product-grid quiz-product-grid">{% for product in products %}{{ product.card }}{% endfor %}</div><form class="quiz-email" action="{{ newsletter_action }}" method="post" data-six-ajax-form><h3>{{ six_email_edit }}</h3><p>{{ six_email_edit_copy }}</p><div><input type="email" name="email" placeholder="{{ six_newsletter_placeholder }}" required><button class="button button--dark" type="submit">{{ six_send_edit }}</button></div><label><input type="checkbox" name="consent" value="1" required> {{ six_consent }}</label><p class="six-form-status" role="status"></p></form></section>
</section>
{{ footer }}
