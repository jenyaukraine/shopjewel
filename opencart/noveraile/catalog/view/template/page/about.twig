{{ header }}
<section class="interior-hero about-hero" aria-labelledby="about-title">
  <div class="about-hero-copy">
    <p class="eyebrow"><span aria-hidden="true"></span> {{ six_about_story }}</p>
    <h1 id="about-title">{{ six_about_title|trim('.') }}</h1>
    <p class="about-hero-lead">{{ six_about_hero_lead }}</p>
    <a class="about-hero-link" href="#our-story">{{ six_about_discover }} <span aria-hidden="true">&#8595;</span></a>
    <p class="about-hero-signature" aria-hidden="true">{{ six_about_signature }}</p>
  </div>
  <figure class="about-hero-visual">
    <img src="{{ asset }}hero-noveraile-v2.png" width="2048" height="701" fetchpriority="high" alt="Gold jewelry arranged on a sculptural display">
    <figcaption><span>{{ six_about_made_slowly }}</span><span>{{ six_about_kept_forever }}</span></figcaption>
  </figure>
</section>

<main class="about-page" id="our-story">
  <section class="about-origin" aria-labelledby="origin-title">
    <div class="about-section-index" aria-hidden="true"><span>01</span><small>{{ six_about_beginning }}</small></div>
    <div class="about-origin-copy">
      <p class="eyebrow">{{ six_about_idea }}</p>
      <h2 id="origin-title">{{ six_about_origin_title|trim('.') }}</h2>
      <p class="about-lead">{{ six_about_origin_one }}</p>
      <p>{{ six_about_origin_two }}</p>
      <p>{{ six_about_origin_three }}</p>
    </div>
    <figure class="about-origin-visual">
      <img src="{{ asset }}about-quote-jewelry.webp" width="1983" height="793" loading="lazy" alt="Gold rings arranged on dark stone and silk">
      <figcaption>{{ six_about_heirloom_caption }}</figcaption>
    </figure>
  </section>

  <section class="about-belief" aria-label="{{ six_about_belief_label }}">
    <span class="about-belief-mark" aria-hidden="true">“</span>
    <blockquote>{{ six_about_belief_quote }}</blockquote>
    <p>{{ six_about_designed }} <span aria-hidden="true"></span> {{ six_about_finished }}</p>
  </section>

  <section class="about-craft" id="craft" aria-labelledby="craft-title">
    <figure class="about-craft-visual">
      <img src="{{ asset }}editorial/craftsmanship.webp" width="1200" height="1200" loading="lazy" alt="Jeweler finishing a gold ring by hand">
      <figcaption><span>02</span> {{ six_about_making }}</figcaption>
    </figure>
    <div class="about-craft-copy">
      <p class="eyebrow">{{ six_about_thoughtfully }}</p>
      <h2 id="craft-title">{{ six_about_craft_title|trim('.') }}</h2>
      <p class="about-lead">{{ six_about_craft_one }}</p>
      <p>{{ six_about_craft_two }}</p>
      <p>{{ six_about_craft_three }}</p>
      <a class="about-text-link" href="{{ six_diamonds_url }}">{{ six_about_explore_diamonds }} <span aria-hidden="true">&#8594;</span></a>
    </div>
  </section>

  <section class="about-values" aria-labelledby="values-title">
    <header>
      <p class="eyebrow">{{ six_about_standards }}</p>
      <h2 id="values-title">{{ six_about_values_title|trim('.') }}</h2>
    </header>
    <div class="about-values-grid">
      <article><span>01</span><h3>{{ six_about_value_one_title|trim('.') }}</h3><p>{{ six_about_value_one_copy }}</p></article>
      <article><span>02</span><h3>{{ six_about_value_two_title|trim('.') }}</h3><p>{{ six_about_value_two_copy }}</p></article>
      <article><span>03</span><h3>{{ six_about_value_three_title|trim('.') }}</h3><p>{{ six_about_value_three_copy }}</p></article>
    </div>
  </section>

  <section class="about-closing" aria-labelledby="closing-title">
    <span class="about-closing-number" aria-hidden="true">6</span>
    <div>
      <p class="eyebrow">{{ six_about_tagline }}</p>
      <h2 id="closing-title">{{ six_about_closing_title|trim('.') }}</h2>
      <p>{{ six_about_closing_copy }}</p>
      <div class="about-closing-actions">
        <a class="button button--light" href="{{ six_catalog_url }}">{{ six_about_collection }}</a>
        <a class="about-text-link about-text-link--light" href="{{ six_contact_url }}">{{ six_about_appointment }} <span aria-hidden="true">&#8594;</span></a>
      </div>
    </div>
  </section>
</main>
{{ footer }}
