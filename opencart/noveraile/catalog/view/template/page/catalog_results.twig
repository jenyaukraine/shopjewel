<div class="catalog-toolbar"><button class="filter-toggle" type="button" data-six-filter-toggle aria-controls="six-catalog-filters" aria-expanded="false">{{ six_filters }}</button><strong>{{ total }} {{ six_pieces }}</strong><label>{{ six_sort }} <select data-six-catalog-sort>{% for sort in sorts %}<option value="{{ sort.href }}"{% if filters.sort == sort.value %} selected{% endif %}>{{ sort.name }}</option>{% endfor %}</select></label></div>
{% if products %}<div class="collection-grid product-grid">{% for product in products %}{{ product }}{% endfor %}</div><div class="pagination-shell">{{ pagination }}<p>{{ result_text }}</p></div>{% else %}<div class="empty-state"><p>{{ six_no_products }}</p><a class="button button--dark" href="{{ clear_url }}">{{ six_clear }}</a></div>{% endif %}
