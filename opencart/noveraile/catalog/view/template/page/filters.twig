<aside class="catalog-filters" id="six-catalog-filters" data-six-filters aria-labelledby="six-filter-title">
  <div class="filter-heading">
    <h2 id="six-filter-title">{{ six_filters|trim('.') }}</h2>
    <div class="filter-heading__actions">
      <a href="{{ clear_url }}">{{ six_clear }}</a>
      <button class="filter-close" type="button" data-six-filter-close aria-label="{{ six_filters|trim('.') }}">&times;</button>
    </div>
  </div>
  <form action="{{ catalog_action }}" method="get"{% if ajax_filter_status %} data-six-ajax-filter{% endif %}>
    <input type="hidden" name="route" value="extension/noveraile/page/catalog"><input type="hidden" name="language" value="{{ language }}">
    <label class="filter-search"><span>{{ six_search }}</span><input type="search" name="q" value="{{ filters.q }}" placeholder="{{ six_search|trim('.') }}" autocomplete="off"></label>
    {% if metals %}<details class="filter-metal"{% if filters.metal %} open{% endif %}><summary>{{ six_metal|trim('.') }}</summary><label class="filter-metal-option"><input type="radio" name="metal" value=""{% if not filters.metal %} checked{% endif %}><span class="metal-swatch metal-swatch--all" aria-hidden="true"></span><span>{{ six_all }}</span></label>{% for item in metals %}<label class="filter-metal-option"><input type="radio" name="metal" value="{{ item.value }}"{% if filters.metal == item.value %} checked{% endif %}><span class="metal-swatch metal-swatch--{{ item.value }}" aria-hidden="true"></span><span>{{ item.name }} <small>({{ item.total }})</small></span></label>{% endfor %}</details>{% endif %}
    {% if finenesses %}<details><summary>{{ six_fineness|trim('.') }}</summary><label><input type="radio" name="fineness" value=""{% if not filters.fineness %} checked{% endif %}> {{ six_all }}</label>{% for item in finenesses %}<label><input type="radio" name="fineness" value="{{ item.value }}"{% if filters.fineness == item.value %} checked{% endif %}> {{ item.name }} <small>({{ item.total }})</small></label>{% endfor %}</details>{% endif %}
    {% if gemstones %}<details><summary>{{ six_gemstone|trim('.') }}</summary><label><input type="radio" name="gemstone" value=""{% if not filters.gemstone %} checked{% endif %}> {{ six_all }}</label>{% for item in gemstones %}<label><input type="radio" name="gemstone" value="{{ item.value }}"{% if filters.gemstone == item.value %} checked{% endif %}> {{ item.value }} <small>({{ item.total }})</small></label>{% endfor %}</details>{% endif %}
    {% if stone_origins %}<details><summary>{{ six_stone|trim('.') }}</summary><label><input type="radio" name="stone" value=""{% if not filters.stone %} checked{% endif %}> {{ six_all }}</label>{% for item in stone_origins %}<label><input type="radio" name="stone" value="{{ item.value }}"{% if filters.stone == item.value %} checked{% endif %}> {{ item.name }} <small>({{ item.total }})</small></label>{% endfor %}</details>{% endif %}
    <details{% if carat_min != '' or carat_max != '' %} open{% endif %}><summary>{{ six_carat|trim('.') }}</summary><div class="price-range attribute-range"><input type="number" name="carat_min" min="0" max="20" step="0.01" inputmode="decimal" value="{{ carat_min }}" placeholder="{{ six_from }}"><span>—</span><input type="number" name="carat_max" min="0" max="20" step="0.01" inputmode="decimal" value="{{ carat_max }}" placeholder="{{ six_to }}"></div></details>
    {% if stone_shapes %}<details><summary>{{ six_stone_shape|trim('.') }}</summary><label><input type="radio" name="stone_shape" value=""{% if not filters.stone_shape %} checked{% endif %}> {{ six_all }}</label>{% for item in stone_shapes %}<label><input type="radio" name="stone_shape" value="{{ item.value }}"{% if filters.stone_shape == item.value %} checked{% endif %}> {{ item.name }} <small>({{ item.total }})</small></label>{% endfor %}</details>{% endif %}
    {% if stone_qualities %}<details><summary>{{ six_stone_quality|trim('.') }}</summary><label><input type="radio" name="stone_quality" value=""{% if not filters.stone_quality %} checked{% endif %}> {{ six_all }}</label>{% for item in stone_qualities %}<label><input type="radio" name="stone_quality" value="{{ item.value }}"{% if filters.stone_quality == item.value %} checked{% endif %}> {{ item.value }} <small>({{ item.total }})</small></label>{% endfor %}</details>{% endif %}
    {% if ring_sizes %}<details{% if filters.ring_size %} open{% endif %}><summary>{{ six_ring_size|trim('.') }}</summary><label><input type="radio" name="ring_size" value=""{% if not filters.ring_size %} checked{% endif %}> {{ six_all }}</label><div class="filter-size-grid">{% for item in ring_sizes %}<label><input type="radio" name="ring_size" value="{{ item.value }}"{% if filters.ring_size == item.value %} checked{% endif %}> <span>{{ item.value }}</span></label>{% endfor %}</div></details>{% endif %}
    {% if styles %}<details><summary>{{ six_jewelry_style|trim('.') }}</summary><label><input type="radio" name="style" value=""{% if not filters.style %} checked{% endif %}> {{ six_all }}</label>{% for item in styles %}<label><input type="radio" name="style" value="{{ item.value }}"{% if filters.style == item.value %} checked{% endif %}> {{ item.value }} <small>({{ item.total }})</small></label>{% endfor %}</details>{% endif %}
    <details{% if price_min != '' or price_max != '' %} open{% endif %}><summary>{{ six_price|trim('.') }} · {{ currency_code }}</summary><div class="price-range price-range--with-slider" data-six-price-range data-min="{{ price_floor }}" data-max="{{ price_ceiling }}"><div class="price-range__inputs"><input type="number" name="price_min" min="{{ price_floor }}" max="{{ price_ceiling }}" value="{{ price_min }}" placeholder="{{ six_from }}" aria-label="{{ six_from }} — {{ six_price }}"><span>—</span><input type="number" name="price_max" min="{{ price_floor }}" max="{{ price_ceiling }}" value="{{ price_max }}" placeholder="{{ six_to }}" aria-label="{{ six_to }} — {{ six_price }}"></div><div class="price-range__slider"><input type="range" min="{{ price_floor }}" max="{{ price_ceiling }}" step="1" value="{{ price_slider_min }}" data-six-price-lower aria-label="{{ six_from }} — {{ six_price }}"><input type="range" min="{{ price_floor }}" max="{{ price_ceiling }}" step="1" value="{{ price_slider_max }}" data-six-price-upper aria-label="{{ six_to }} — {{ six_price }}"></div></div></details>
    <details><summary>{{ six_availability|trim('.') }}</summary><label><input type="radio" name="availability" value=""{% if not filters.availability %} checked{% endif %}> {{ six_all }}</label><label><input type="radio" name="availability" value="ready"{% if filters.availability == 'ready' %} checked{% endif %}> {{ six_ready }}</label><label><input type="radio" name="availability" value="preorder"{% if filters.availability == 'preorder' %} checked{% endif %}> {{ six_preorder }}</label></details>
    <details><summary>{{ six_delivery|trim('.') }}</summary><label><input type="radio" name="delivery" value=""{% if not filters.delivery %} checked{% endif %}> {{ six_all }}</label><label><input type="radio" name="delivery" value="delivery-3"{% if filters.delivery == 'delivery-3' %} checked{% endif %}> {{ six_delivery_3 }}</label><label><input type="radio" name="delivery" value="delivery-10"{% if filters.delivery == 'delivery-10' %} checked{% endif %}> {{ six_delivery_10 }}</label></details>
    {% if filters.type %}<input type="hidden" name="type" value="{{ filters.type }}">{% endif %}{% if filters.moment %}<input type="hidden" name="moment" value="{{ filters.moment }}">{% endif %}{% if filters.category_id %}<input type="hidden" name="category_id" value="{{ filters.category_id }}">{% endif %}{% if filters.sale %}<input type="hidden" name="sale" value="1">{% endif %}{% if filters.sort and filters.sort != 'popular' %}<input type="hidden" name="sort" value="{{ filters.sort }}">{% endif %}
    <button class="button button--dark" type="submit">{{ six_apply }}</button>
  </form>
</aside>
