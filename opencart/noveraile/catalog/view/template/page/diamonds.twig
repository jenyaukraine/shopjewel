{{ header }}
<section class="diamond-page-hero"><img src="{{ asset }}editorial/lab-grown-diamond.png" alt="{{ six_diamond_alt }}"><div><p class="eyebrow">{{ six_lab_kicker }}</p><h1>{{ six_diamonds_title|trim('.') }}</h1><p>{{ six_lab_copy }}</p><a class="button button--light" href="{{ catalog }}">{{ six_shop_lab }}</a></div></section>
<section class="diamond-comparison"><div class="editorial-heading"><h2>{{ six_diamond_comparison_title|trim('.') }}</h2></div><div class="comparison-table"><div class="comparison-row comparison-head"><span></span><strong>{{ six_natural }}</strong><strong>{{ six_lab_grown }}</strong></div><div class="comparison-row"><span>{{ six_diamond_origin }}</span><span>{{ six_diamond_origin_natural }}</span><span>{{ six_diamond_origin_lab }}</span></div><div class="comparison-row"><span>{{ six_diamond_appearance }}</span><span>{{ six_diamond_appearance_natural }}</span><span>{{ six_diamond_appearance_lab }}</span></div><div class="comparison-row"><span>{{ six_diamond_certification }}</span><span>{{ six_diamond_certification_natural }}</span><span>{{ six_diamond_certification_lab }}</span></div><div class="comparison-row"><span>{{ six_price }}</span><span>{{ six_diamond_price_natural }}</span><span>{{ six_diamond_price_lab }}</span></div></div></section>
<section class="diamond-faq"><div><p class="eyebrow">FAQ</p><h2>{{ six_faq_title|trim('.') }}</h2></div><div><details open><summary>{{ six_diamond_faq_fake_q }}</summary><p>{{ six_diamond_faq_fake_a }}</p></details><details><summary>{{ six_diamond_faq_verify_q }}</summary><p>{{ six_diamond_faq_verify_a }}</p></details><details><summary>{{ six_diamond_faq_value_q }}</summary><p>{{ six_diamond_faq_value_a }}</p></details></div></section>
{{ footer }}
