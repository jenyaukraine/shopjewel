{% if products %}
  {% if error_warning %}<div class="cart-page-alert is-error" role="alert">{{ error_warning }}</div>{% endif %}
  {% if error_stock %}<div class="cart-page-alert is-error" role="alert">{{ error_stock }}</div>{% endif %}
  {% if success %}<div class="cart-page-alert is-success" role="status">{{ success }}</div>{% endif %}
  {% if attention %}<div class="cart-page-alert is-info" role="status">{{ attention }}</div>{% endif %}

  <div id="output-cart" class="cart-page-layout">
    <section class="cart-page-products" aria-label="{{ six_bag }}">
      <div class="cart-page-section-heading">
        <div><p class="eyebrow">{{ six_cart_kicker }}</p><h2>{{ six_bag|trim('.') }} <sup>{{ products|length }}</sup></h2></div>
        {% if weight %}<span>{{ weight }}</span>{% endif %}
      </div>
      {% for product in products %}
        <article class="cart-page-item">
          <a class="cart-page-item-image" href="{{ product.href }}">{% if product.thumb %}<img src="{{ product.thumb }}" alt="{{ product.name }}" loading="lazy">{% endif %}<span aria-hidden="true">↗</span></a>
          <div class="cart-page-item-body">
            <div class="cart-page-item-heading">
              <div><p>{{ text_model }} · {{ product.model }}</p><h3><a href="{{ product.href }}">{{ product.name|trim('.') }}</a>{% if not product.stock %}<span class="cart-page-stock">*</span>{% endif %}</h3></div>
              <strong>{{ product.total }}</strong>
            </div>
            {% if product.option or product.subscription or product.reward %}
              <ul class="cart-page-options">
                {% for option in product.option %}<li>{{ option.name }}: {{ option.value }}</li>{% endfor %}
                {% if product.subscription %}<li>{{ text_subscription }}: {{ product.subscription }}</li>{% endif %}
                {% if product.reward %}<li>{{ text_points }}: {{ product.reward }}</li>{% endif %}
              </ul>
            {% endif %}
            {% if product.minimum %}<p class="cart-page-minimum">{{ product.minimum }}</p>{% endif %}
            <div class="cart-page-item-footer">
              <form class="cart-page-quantity-form" action="{{ edit }}" method="post" data-cart-auto-update>
                <label>{{ column_quantity }}</label>
                <div class="cart-page-quantity">
                  <button type="button" data-cart-step="-1" aria-label="−"{% if product.quantity <= 1 %} disabled{% endif %}>−</button>
                  <input type="number" name="quantity" min="1" value="{{ product.quantity }}" aria-label="{{ column_quantity }}">
                  <button type="button" data-cart-step="1" aria-label="+">+</button>
                </div>
                <input type="hidden" name="key" value="{{ product.cart_id }}">
              </form>
              <a class="cart-page-remove" href="{{ product.remove }}"><span aria-hidden="true">×</span>{{ button_remove }}</a>
            </div>
          </div>
        </article>
      {% endfor %}
    </section>

    <aside class="cart-page-summary">
      <div class="cart-page-summary-heading"><div><p class="eyebrow">{{ six_brand_name }}</p><h2>{{ six_cart_summary|trim('.') }}</h2></div><svg class="summary-bag-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M6.5 8.5h11l1 11h-13l1-11Z"/><path d="M9 9V6.5a3 3 0 0 1 6 0V9"/></svg></div>
      <div class="cart-page-totals">
        {% for total in totals %}<div><span>{{ total.title }}</span><strong>{{ total.text }}</strong></div>{% endfor %}
      </div>
      <a class="button button--dark cart-page-checkout" href="{{ checkout }}">{{ button_checkout }} <span>→</span></a>
      <a class="cart-page-continue" href="{{ continue }}">← {{ button_shopping }}</a>
      <ul class="cart-page-assurances">
        <li><svg class="assurance-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M12 3 20 6v5.5c0 4.5-3.2 7.8-8 9.5-4.8-1.7-8-5-8-9.5V6Z"/><path d="m8.5 12 2.2 2.2 4.8-4.8"/></svg><div><strong>{{ six_cart_secure }}</strong><small>{{ six_cart_secure_copy }}</small></div></li>
        <li><svg class="assurance-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M3 6h11v10H3ZM14 9h4l3 3v4h-7Z"/><circle cx="7" cy="18" r="2"/><circle cx="18" cy="18" r="2"/></svg><div><strong>{{ six_benefit_delivery_title }}</strong><small>{{ six_cart_delivery_copy }}</small></div></li>
        <li><svg class="assurance-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M4 7v5h5"/><path d="M5.2 12A7 7 0 1 0 7 6.5L4 9"/></svg><div><strong>{{ six_returns }}</strong><small>{{ six_cart_returns_copy }}</small></div></li>
      </ul>
    </aside>
  </div>

  <section class="cart-page-modules">
    <div class="cart-page-modules-intro"><p class="eyebrow">{{ six_brand_name }} · {{ six_bag }}</p><h2>{{ six_coupon_title|trim('.') }}</h2><p>{{ six_coupon_copy }}</p></div>
    <div class="cart-page-module-grid">
      <form action="{{ six_coupon_action }}" method="post" class="six-coupon-form"><label for="six-coupon">{{ six_coupon_label }}</label><div><input id="six-coupon" type="text" name="coupon" value="{{ coupon|default('') }}" autocomplete="off" required><button class="button button--dark" type="submit">{{ six_coupon_apply }}</button></div>{% if six_coupon_status == 'success' %}<p class="six-form-status is-success">{{ six_coupon_success }}</p>{% elseif six_coupon_status == 'error' %}<p class="six-form-status is-error">{{ six_coupon_error }}</p>{% endif %}</form>
      {% for module in modules %}{{ module }}{% endfor %}
    </div>
  </section>
{% else %}
  <section class="cart-page-empty">
    <div class="cart-page-empty-mark" aria-hidden="true"><small>01 / 06</small><svg class="summary-bag-icon" viewBox="0 0 24 24" focusable="false"><path d="M6.5 8.5h11l1 11h-13l1-11Z"/><path d="M9 9V6.5a3 3 0 0 1 6 0V9"/></svg></div>
    <div class="cart-page-empty-copy">
      <p class="eyebrow">{{ six_bag }} · 0</p>
      <h2>{{ six_cart_empty_title|trim('.') }}</h2>
      <p>{{ six_cart_empty_copy }}</p>
      <a class="button button--dark" href="{{ continue }}">{{ six_catalog }} <span>→</span></a>
    </div>
  </section>
  <div class="cart-page-empty-benefits">
    <div><span><svg class="line-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M6.5 4.5h11L21 9l-9 10.5L3 9Z"/><path d="M3 9h18M8.5 4.5 6.8 9 12 19.5 17.2 9l-1.7-4.5"/></svg></span><strong>{{ six_benefit_cert_title }}</strong><small>{{ six_benefit_cert_copy }}</small></div>
    <div><span><svg class="line-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M12 3 20 6v5.5c0 4.5-3.2 7.8-8 9.5-4.8-1.7-8-5-8-9.5V6Z"/><path d="m8.4 12 2.2 2.2 5-5"/></svg></span><strong>{{ six_benefit_delivery_title }}</strong><small>{{ six_benefit_delivery_copy }}</small></div>
    <div><span><svg class="line-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><circle cx="12" cy="9" r="3.25"/><path d="M5.5 20c.7-3.5 3-5.3 6.5-5.3s5.8 1.8 6.5 5.3M5 11v-1a7 7 0 0 1 14 0v1M5 11v3h2M19 11v3h-2"/></svg></span><strong>{{ six_benefit_service_title }}</strong><small>{{ six_benefit_service_copy }}</small></div>
  </div>
{% endif %}
