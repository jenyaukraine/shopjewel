{{ header }}
<section id="checkout-checkout" class="checkout-page" data-six-simple-checkout
  data-guest-label="{{ six_checkout_guest_label|e('html_attr') }}"
  data-account-label="{{ six_checkout_account_label|e('html_attr') }}"
  data-continue-label="{{ six_checkout_continue_label|e('html_attr') }}"
  data-optional-label="{{ six_checkout_optional_label|e('html_attr') }}"
  data-note-label="{{ six_checkout_note_label|e('html_attr') }}">
  <div class="checkout-page-shell">
    <nav class="checkout-page-progress" aria-label="{{ heading_title }}">
      <a href="{{ six_cart_url }}"><i>01</i>{{ six_bag }}</a>
      <span><i>02</i>{{ six_benefit_delivery_title }}</span>
      <span class="is-current"><i>03</i>{{ heading_title }}</span>
    </nav>

    <header class="checkout-page-masthead">
      <div>
        <p class="eyebrow">NOVERAILE · {{ six_checkout_kicker }}</p>
        <h1>{{ heading_title }}</h1>
      </div>
      <div class="checkout-page-intro">
        <p>{{ six_checkout_intro }}</p>
        <span><i aria-hidden="true">◇</i>{{ six_cart_secure }}</span>
      </div>
    </header>

    <div class="checkout-page-roadmap" aria-label="{{ heading_title }}">
      <div><i aria-hidden="true">1</i><p><strong>{{ six_checkout_contact_step }}</strong><span>{{ six_checkout_contact_step_copy }}</span></p></div>
      <div><i aria-hidden="true">2</i><p><strong>{{ six_checkout_delivery_step }}</strong><span>{{ six_checkout_delivery_step_copy }}</span></p></div>
      <div><i aria-hidden="true">3</i><p><strong>{{ six_checkout_payment_step }}</strong><span>{{ six_checkout_payment_step_copy }}</span></p></div>
    </div>

    <div class="checkout-page-grid">
      <div class="checkout-page-details">
        {{ content_top }}
        {% if register %}<section id="checkout-register" class="checkout-page-section">{{ register }}</section>{% endif %}
        {% if payment_address %}<section id="checkout-payment-address" class="checkout-page-section">{{ payment_address }}</section>{% endif %}
        {% if shipping_address %}<section id="checkout-shipping-address" class="checkout-page-section">{{ shipping_address }}</section>{% endif %}
        {% if shipping_method %}<section id="checkout-delivery-step" class="checkout-page-section checkout-page-choice">{{ shipping_method }}</section>{% endif %}
        <section id="checkout-payment-step" class="checkout-page-section checkout-page-choice">{{ payment_method }}</section>
        <div class="checkout-page-help">
          <span aria-hidden="true">◎</span>
          <p><strong>{{ six_checkout_help_title }}</strong>{{ six_checkout_help_copy }} <a href="{{ six_contact_url }}">{{ six_contact }} →</a></p>
        </div>
      </div>

      <aside class="checkout-page-sidebar">
        <div class="checkout-page-sidebar-heading">
          <div><p class="eyebrow">NOVERAILE</p><h2>{{ six_cart_summary }}</h2></div>
          <svg class="summary-bag-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M6.5 8.5h11l1 11h-13l1-11Z"/><path d="M9 9V6.5a3 3 0 0 1 6 0V9"/></svg>
        </div>
        <div id="checkout-confirm" class="checkout-page-confirm">{{ confirm }}</div>
        <div class="checkout-page-assurance">
          <span aria-hidden="true">◇</span>
          <p><strong>{{ six_checkout_assurance_title }}</strong>{{ six_checkout_assurance_copy }}</p>
        </div>
      </aside>
    </div>
    {{ content_bottom }}
  </div>
</section>
{{ footer }}
