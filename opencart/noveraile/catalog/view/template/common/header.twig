<!DOCTYPE html>
<html dir="{{ direction }}" lang="{{ lang }}">
<head>
  <meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="color-scheme" content="light"><meta name="theme-color" content="#f8f5ef">
  <title>{{ title }}</title><base href="{{ base }}">
  {% if description %}<meta name="description" content="{{ description }}">{% endif %}
  {% if keywords %}<meta name="keywords" content="{{ keywords }}">{% endif %}
  <meta property="og:site_name" content="{{ six_brand_name }}"><meta property="og:title" content="{{ title }}"><meta property="og:type" content="website"><meta property="og:image" content="{{ six_og_image }}">{% if six_canonical %}<meta property="og:url" content="{{ six_canonical }}">{% endif %}
  <link rel="preload" as="image" href="/image/catalog/noveraile/hero-noveraile-v2.png" media="(min-width: 681px)" fetchpriority="high"><link rel="preload" as="image" href="/image/catalog/noveraile/hero-noveraile-mobile.png" media="(max-width: 680px)" fetchpriority="high">
  <script src="{{ jquery }}"></script>
  <link href="{{ bootstrap }}" rel="stylesheet"><link href="{{ icons }}" rel="stylesheet"><link href="{{ six_stylesheet }}" rel="stylesheet">
  <script src="catalog/view/javascript/common.js"></script>
  <link rel="icon" href="{{ six_favicon }}" type="image/svg+xml">
  {% for style in styles %}<link href="{{ style.href }}" rel="{{ style.rel }}" media="{{ style.media }}">{% endfor %}
  {% for script in scripts %}<script src="{{ script.href }}"></script>{% endfor %}
  {% for link in links %}<link href="{{ link.href }}" rel="{{ link.rel }}">{% endfor %}
  {% for analytic in analytics %}{{ analytic }}{% endfor %}
</head>
<body class="noveraile-store" data-language="{{ six_language_code }}">
<div id="container" class="site-shell">
  <div id="alert"></div>
  <div class="announcement">{{ six_announcement }}</div>
  <header class="site-header">
    <a class="wordmark" href="{{ six_home }}" aria-label="{{ six_brand_name }}">{{ six_brand_name }}</a>
    <nav class="desktop-nav" aria-label="Primary">
      <div class="mega-menu-shell{% if six_mega_menu_status %} is-enabled{% endif %}">
        <a class="desktop-nav-link" href="{{ six_catalog_url }}"{% if six_mega_menu_status %} aria-haspopup="true"{% endif %}>{{ six_catalog }}</a>
        {% if six_mega_menu_status %}
          <div class="mega-menu" role="group" aria-label="{{ six_mega_menu_title }}">
            <div class="mega-menu-heading">
              <span><i aria-hidden="true"></i><small>{{ six_mega_menu_title }}</small></span>
              <a href="{{ six_catalog_url }}">{{ six_view_all }} <b aria-hidden="true">→</b></a>
            </div>
            <div class="mega-menu-grid">
              {% for category in six_categories %}
                <a href="{{ category.href }}">
                  <span class="mega-menu-icon" aria-hidden="true"><svg viewBox="0 0 32 32" focusable="false">{% if category.icon == 'ring' %}<ellipse cx="16" cy="19" rx="8.5" ry="9.5"/><path d="m12.5 10 1.8-3h3.4l1.8 3-3.5 3Z"/>{% elseif category.icon == 'earring' %}<path d="M10 7v9.5a5 5 0 1 0 5 5V9"/><path d="M19.5 8.5v8a4 4 0 1 0 4 4V11"/><circle cx="10" cy="6" r="1.4"/><circle cx="19.5" cy="7.5" r="1.4"/>{% elseif category.icon == 'necklace' %}<path d="M5 7c1.8 8 5.4 12 11 12S25.2 15 27 7"/><path d="m16 18-3 4 3 4 3-4Z"/>{% elseif category.icon == 'bracelet' %}<ellipse cx="16" cy="17" rx="10" ry="8"/><path d="M8.5 11.5 11 9l2.5 2.5M18.5 10l2.5-2 2.5 2.5"/><circle cx="16" cy="9" r="1.5"/>{% elseif category.icon == 'wedding' %}<circle cx="12" cy="17" r="7"/><circle cx="20" cy="17" r="7"/><path d="m16 8 1.5-2h3L22 8l-3 2Z"/>{% else %}<path d="m6 12 4-6h12l4 6-10 14Z"/><path d="M6 12h20M10 6l6 6 6-6M11 12l5 14 5-14"/>{% endif %}</svg></span>
                  <span class="mega-menu-copy"><strong>{{ category.name }}</strong><small>{{ category.total|default(0) }} {{ six_pieces }}</small></span>
                  <span class="mega-menu-arrow" aria-hidden="true">→</span>
                </a>
              {% endfor %}
            </div>
            <a class="mega-menu-promo" href="{{ six_mega_menu_promo_url }}">
              <small>{{ six_mega_menu_title }}</small>
              <span>{{ six_mega_menu_promo_text }}</span>
              <b aria-hidden="true">→</b>
            </a>
          </div>
        {% endif %}
      </div>
      <a class="desktop-nav-link" href="{{ six_about_url }}">{{ six_about }}</a><a class="desktop-nav-link" href="{{ six_quiz_url }}">{{ six_quiz }}</a><a class="desktop-nav-link" href="{{ six_journal_url }}">{{ six_journal }}</a>
    </nav>
    <div class="header-actions">
      <button class="header-search-trigger" type="button" data-six-search-open aria-label="{{ six_search }}">⌕</button>
      <span class="six-switcher" data-switcher="currency" data-current="{{ six_currency_code }}">{{ currency }}</span><span class="six-switcher" data-switcher="language" data-current="{{ six_language_code }}">{{ language }}</span>
      <a href="{{ contact }}">{{ six_contact }}</a>
      <a href="{{ shopping_cart }}" class="bag"><svg class="bag-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M6.5 8.5h11l1 11h-13l1-11Z"/><path d="M9 9V6.5a3 3 0 0 1 6 0V9"/></svg>{{ six_bag }} <span>{{ six_cart_count }}</span></a>
    </div>
    <button class="mobile-menu-trigger" type="button" data-six-menu-open aria-controls="six-mobile-menu" aria-expanded="false"><span>☰</span> {{ six_menu }}</button>
  </header>
  <div class="search-overlay" data-six-search aria-hidden="true">
    <button class="search-backdrop" type="button" data-six-search-close aria-label="Close"></button>
    <div class="search-panel"><button class="search-close" type="button" data-six-search-close>×</button><p class="eyebrow">{{ six_brand_name }}</p><form action="{{ six_search_action }}" method="get" data-six-search-form data-suggest-url="{{ six_search_suggest }}"><input type="hidden" name="route" value="extension/noveraile/page/catalog"><input type="hidden" name="language" value="{{ six_language_code }}"><label for="six-site-search">{{ six_search }}</label><div><input id="six-site-search" type="search" name="q" autocomplete="off" placeholder="{{ six_search_placeholder }}"><button type="submit">→</button></div><div class="search-suggestions" data-six-suggestions></div></form></div>
  </div>
  <aside class="mobile-drawer-shell" id="six-mobile-menu" aria-hidden="true">
    <button class="mobile-drawer-backdrop" type="button" data-six-menu-close aria-label="Close"></button>
    <div class="mobile-drawer">
      <div class="mobile-drawer-header"><strong>{{ six_menu }}</strong><button type="button" data-six-menu-close>×</button></div>
      <nav class="mobile-category-nav" aria-label="{{ six_catalog }}">{% for category in six_categories %}<a href="{{ category.href }}"><span class="mobile-category-icon" aria-hidden="true"><svg viewBox="0 0 32 32" focusable="false">{% if category.icon == 'ring' %}<ellipse cx="16" cy="19" rx="8.5" ry="9.5"/><path d="m12.5 10 1.8-3h3.4l1.8 3-3.5 3Z"/>{% elseif category.icon == 'earring' %}<path d="M10 7v9.5a5 5 0 1 0 5 5V9"/><path d="M19.5 8.5v8a4 4 0 1 0 4 4V11"/><circle cx="10" cy="6" r="1.4"/><circle cx="19.5" cy="7.5" r="1.4"/>{% elseif category.icon == 'necklace' %}<path d="M5 7c1.8 8 5.4 12 11 12S25.2 15 27 7"/><path d="m16 18-3 4 3 4 3-4Z"/>{% elseif category.icon == 'bracelet' %}<ellipse cx="16" cy="17" rx="10" ry="8"/><path d="M8.5 11.5 11 9l2.5 2.5M18.5 10l2.5-2 2.5 2.5"/><circle cx="16" cy="9" r="1.5"/>{% elseif category.icon == 'wedding' %}<circle cx="12" cy="17" r="7"/><circle cx="20" cy="17" r="7"/><path d="m16 8 1.5-2h3L22 8l-3 2Z"/>{% else %}<path d="m6 12 4-6h12l4 6-10 14Z"/><path d="M6 12h20M10 6l6 6 6-6M11 12l5 14 5-14"/>{% endif %}</svg></span><span class="mobile-category-label">{{ category.name }}</span><span class="mobile-category-arrow" aria-hidden="true">→</span></a>{% endfor %}</nav>
      <nav class="mobile-main-nav">
        <a href="{{ six_home }}"><span class="mobile-main-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="m3 10 9-7 9 7"/><path d="M5.5 9v12h13V9M9.5 21v-6h5v6"/></svg></span>{{ six_home_label }}</a><a href="{{ six_catalog_url }}"><span class="mobile-main-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="m4 8 3-4h10l3 4-8 12Z"/><path d="M4 8h16M7 4l5 4 5-4"/></svg></span>{{ six_catalog }}</a><button type="button" data-six-search-open><span class="mobile-main-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><circle cx="10.5" cy="10.5" r="6.5"/><path d="m15.5 15.5 5 5"/></svg></span>{{ six_search }}</button><a href="{{ six_quiz_url }}"><span class="mobile-main-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="4"/><path d="M12 3v3M21 12h-3M12 21v-3M3 12h3"/></svg></span>{{ six_quiz }}</a><a href="{{ six_about_url }}"><span class="mobile-main-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M5 4.5h10a4 4 0 0 1 4 4V21H9a4 4 0 0 1-4-4Z"/><path d="M9 4.5V17a4 4 0 0 0 4 4"/></svg></span>{{ six_about }}</a><a href="{{ six_diamonds_url }}"><span class="mobile-main-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="m3.5 8 3.6-4h9.8l3.6 4L12 20Z"/><path d="M3.5 8h17M7.1 4 12 8l4.9-4"/></svg></span>{{ six_diamonds }}</a><a href="{{ six_journal_url }}"><span class="mobile-main-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M5 3.5h11a3 3 0 0 1 3 3V21H8a3 3 0 0 1-3-3Z"/><path d="M8 3.5V18a3 3 0 0 0 3 3M11 8h5M11 12h5"/></svg></span>{{ six_journal }}</a>
      </nav>
      <div class="mobile-drawer-controls"><span data-switcher="currency" data-current="{{ six_currency_code }}">{{ currency|replace({'form-currency':'form-currency-mobile'}) }}</span><span data-switcher="language" data-current="{{ six_language_code }}">{{ language|replace({'form-language':'form-language-mobile'}) }}</span></div>
      <div class="mobile-drawer-contact"><a href="{{ shopping_cart }}">{{ six_bag }} · {{ six_cart_count }}</a><a href="{{ account|default(login) }}">{{ six_account }}</a></div>
    </div>
  </aside>
  {% if six_native_menu_status and menu %}<div class="six-extension-menu" data-six-extension-menu>{{ menu }}</div>{% endif %}
  <div class="six-search-bar">{{ search }}</div>
  <main id="main-content">
