{{ header }}
{% for block in six_home_blocks %}
{% if block == 'hero' %}
<section class="hero" aria-label="{{ six_brand_name }}">
  <div class="hero-backgrounds">{% for slide in six_hero_slides %}<picture class="hero-background{% if loop.first %} is-active{% endif %}" data-six-hero-slide><source media="(max-width: 680px)" srcset="{{ slide.mobile }}"><img src="{{ slide.image }}" width="{{ slide.width }}" height="{{ slide.height }}" alt="" style="object-position:{{ slide.position }}"{% if loop.first %} fetchpriority="high" loading="eager"{% else %} loading="lazy"{% endif %} decoding="async"></picture>{% endfor %}</div>
  <div class="hero-copy">{% for slide in six_hero_slides %}<div class="hero-message{% if loop.first %} is-active{% endif %}" data-six-hero-message><p class="hero-kicker">{{ slide.kicker }}</p><h1>{{ slide.title }}</h1><div class="hero-actions"><a class="button button--dark" href="{{ six_catalog }}">{{ six_hero_primary }}</a><a class="hero-learn" href="{{ six_quiz }}">{{ six_hero_secondary }} <span>→</span></a></div></div>{% endfor %}</div>
  <div class="hero-pagination" aria-label="{{ six_carousel }}">{% for slide in six_hero_slides %}<button type="button" data-six-hero-dot="{{ loop.index0 }}"{% if loop.first %} class="is-active"{% endif %} aria-label="{{ loop.index }}"></button>{% endfor %}</div>
</section>
{% elseif block == 'featured' %}
<section class="moments-section editorial-products signature-section"><div class="editorial-heading"><p class="editorial-script">{{ six_signature }}</p><h2>{{ six_desired }}</h2><p>{{ six_desired_copy }}</p><a class="sale-link" href="{{ six_catalog }}">{{ six_view_all }} →</a></div><div class="collection-grid product-grid">{% for product in six_products|slice(0,3) %}{{ product }}{% endfor %}</div></section>
{% elseif block == 'benefits' %}
<section class="benefits-strip" aria-label="{{ six_brand_name }}">
  <article><span class="benefit-icon"><svg class="line-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><circle cx="12" cy="10" r="6.5"/><path d="m8 15-1 6 5-2 5 2-1-6M9.5 10l1.6 1.6 3.5-3.5"/></svg></span><h3>{{ six_benefit_cert_title }}</h3><p>{{ six_benefit_cert_copy }}</p></article>
  <article><span class="benefit-icon"><svg class="line-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M3 6h11v10H3ZM14 9h4l3 3v4h-7Z"/><circle cx="7" cy="18" r="2"/><circle cx="18" cy="18" r="2"/></svg></span><h3>{{ six_benefit_delivery_title }}</h3><p>{{ six_benefit_delivery_copy }}</p></article>
  <article><span class="benefit-icon"><svg class="line-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M12 3 20 6v5.5c0 4.5-3.2 7.8-8 9.5-4.8-1.7-8-5-8-9.5V6Z"/><path d="m8.5 12 2.2 2.2 4.8-4.8"/></svg></span><h3>{{ six_benefit_craft_title }}</h3><p>{{ six_benefit_craft_copy }}</p></article>
  <article><span class="benefit-icon"><svg class="line-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="9"/><path d="m8 12 2.6 2.6L16.5 9"/></svg></span><h3>{{ six_benefit_service_title }}</h3><p>{{ six_benefit_service_copy }}</p></article>
</section>
{% elseif block == 'categories' %}
<section class="collections-intro"><div><p class="eyebrow">{{ six_collections }}</p><h2>{{ six_collections_title }}</h2><p>{{ six_collections_copy }}</p></div></section>
<section class="category-showcase">{% for category in six_category_tiles %}<a href="{{ category.href }}"><img src="{{ category.image }}" width="1200" height="1200" loading="lazy" decoding="async" alt="{{ category.name }}"><span>{{ category.name }}</span></a>{% endfor %}</section>
{% elseif block == 'collections' %}
<section class="moment-tiles" aria-label="{{ six_collections_title }}">{% for moment in six_moments %}<a class="moment-tile" href="{{ moment.href }}"><img src="{{ moment.image }}" width="1200" height="1200" loading="lazy" decoding="async" alt="{{ moment.title }} — {{ moment.category }}"><span class="moment-tile__shade" aria-hidden="true"></span><span class="moment-tile__content"><span class="moment-tile__meta"><span class="moment-tile__number">{{ moment.code }}</span><span class="moment-tile__category">{{ moment.category }}</span></span><span class="moment-tile__footer"><span class="moment-tile__title">{{ moment.title }}</span><span class="moment-tile__arrow" aria-hidden="true">↗</span></span></span></a>{% endfor %}</section>
{% elseif block == 'specials' %}
{% if six_special_products %}<section class="moments-section editorial-products sale-section"><div class="editorial-heading"><p class="editorial-script">{{ six_specials }}</p><h2>{{ six_specials_title }}</h2><a class="sale-link" href="{{ six_special }}">{{ six_view_all }} →</a></div><div class="sale-rail" data-six-rail>{% for product in six_special_products %}{{ product }}{% endfor %}</div></section>{% endif %}
{% elseif block == 'story' %}
<section class="craft"><img class="craft-image" src="{{ six_asset }}editorial/craftsmanship.webp" width="1200" height="1200" loading="lazy" decoding="async" alt=""><div class="craft-copy"><p class="eyebrow">{{ six_craft_kicker }}</p><h2>{{ six_craft_title }}</h2><p>{{ six_craft_copy }}</p><a class="text-link" href="{{ six_about }}">{{ six_craft_link }} <span>→</span></a></div></section>
<section class="lab-diamond-banner"><img src="{{ six_asset }}editorial/lab-grown-diamond.png" width="1774" height="887" loading="lazy" decoding="async" alt=""><div class="lab-diamond-overlay"></div><div class="lab-diamond-copy"><p class="eyebrow">{{ six_lab_kicker }}</p><h2>{{ six_lab_title }}</h2><p>{{ six_lab_copy }}</p><div><a class="button button--light" href="{{ six_catalog }}&stone=lab-grown">{{ six_shop_lab }}</a><a class="lab-learn-link" href="{{ six_diamonds }}">{{ six_discover_more }} →</a></div></div></section>
<section class="brand-story"><div class="brand-story-visual"><img src="{{ six_asset }}editorial/journal-heirlooms.webp" width="1200" height="1200" loading="lazy" decoding="async" alt=""><span>01 · {{ six_story_kicker }}</span></div><div class="brand-story-copy"><p class="editorial-script">{{ six_story_kicker }}</p><h2>{{ six_story_title }}</h2><p class="brand-story-lead">{{ six_story_copy }}</p><a class="button story-button" href="{{ six_about }}">{{ six_read_story }} →</a></div></section>
{% elseif block == 'social' %}
<section class="instagram-callout">
  <div class="instagram-callout__copy"><p class="eyebrow"><span aria-hidden="true"></span>Instagram</p><h3>{{ six_follow }}</h3><p>{{ six_follow_copy }}</p></div>
  <a class="instagram-callout__link" href="{{ six_instagram }}" target="_blank" rel="noopener"><span>{{ six_instagram_label }}</span><span class="instagram-callout__arrow" aria-hidden="true">↗</span></a>
</section>
{% elseif block == 'journal' %}
{% if six_articles %}<section class="journal-preview"><div class="editorial-heading"><p class="editorial-script">{{ six_journal }}</p><h2>{{ six_journal_title }}</h2><a class="sale-link" href="{{ six_journal_url }}">{{ six_view_all }} →</a></div><div class="journal-preview-grid">{% for article in six_articles %}<a href="{{ article.href }}"><img src="{{ article.image }}" width="900" height="620" loading="lazy" decoding="async" alt="{{ article.name }}"><p class="eyebrow">{{ six_journal }}</p><h3>{{ article.name }}</h3><p>{{ article.description }}</p></a>{% endfor %}</div></section>{% endif %}
{% endif %}
{% endfor %}
{{ footer }}
