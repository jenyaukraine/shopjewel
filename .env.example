OPENCART_VERSION=4.1.0.3
OPENCART_HTTP_SERVER=http://localhost:8080/

OPENCART_DB_NAME=opencart
OPENCART_DB_USER=opencart
OPENCART_DB_PASSWORD=replace_with_a_long_random_password
OPENCART_DB_ROOT_PASSWORD=replace_with_another_long_random_password
OPENCART_DB_PREFIX=oc_

OPENCART_ADMIN_USERNAME=admin
# OpenCart 4.1 CLI installer accepts 5-20 characters here.
OPENCART_ADMIN_PASSWORD=replace_me_123456
OPENCART_ADMIN_EMAIL=admin@example.com

# Optional immutable tag used by CI releases.
MODULE_IMAGE_TAG=latest
